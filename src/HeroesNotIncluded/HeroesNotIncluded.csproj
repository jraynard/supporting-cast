<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The exe's icon in Explorer and the Windows taskbar (tools/gen_icon.py). -->
    <ApplicationIcon>..\..\packaging\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HeroesNotIncluded.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\narsil\src\Narsil\Narsil.csproj" />
    <ProjectReference Include="..\..\external\narsil\src\Narsil.Voxel\Narsil.Voxel.csproj" />
    <ProjectReference Include="..\..\external\narsil\src\Narsil.Audio\Narsil.Audio.csproj" />
    <ProjectReference Include="..\..\external\narsil\src\Narsil.Speech\Narsil.Speech.csproj" />
    <ProjectReference Include="..\HeroesNotIncluded.Sim\HeroesNotIncluded.Sim.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\data\**\*" LinkBase="data" CopyToOutputDirectory="PreserveNewest" />
    <!-- The mods that ship with the game (docs/MODDING.md): their data, not their sources or builds. -->
    <None Include="..\..\mods\**\*" Exclude="..\..\mods\**\bin\**;..\..\mods\**\obj\**;..\..\mods\**\*.cs;..\..\mods\**\*.csproj" LinkBase="mods" CopyToOutputDirectory="PreserveNewest" />
    <!-- BRUTAL License 2.3: NOTICE.txt must be distributed alongside the product. -->
    <None Include="..\..\NOTICE.txt" Link="NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Bundled UI font (SIL Open Font License 1.1): its license ships with the other third-party notices. -->
    <None Include="..\..\data\fonts\FiraSans-OFL.txt" Link="licenses\FiraSans-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- The title's lettering (SIL Open Font License 1.1), the brand's display face. -->
    <None Include="..\..\data\fonts\Cinzel-OFL.txt" Link="licenses\Cinzel-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The mods that ship with the game (mods/*/src/*): built after the game into their own folders, the game's
       assemblies not rebuilt for them, so a `dotnet run` of the game has its own trades. The game never references
       them: it loads them as mods (docs/MODDING.md). -->
  <Target Name="BuildBundledMods" AfterTargets="Build" Condition="'$(BuildingBundledMods)' != 'true'">
    <ItemGroup>
      <BundledModSim Include="..\..\mods\*\src\*.Sim\*.csproj" />
      <BundledModGame Include="..\..\mods\*\src\*\*.csproj" Exclude="@(BundledModSim)" />
    </ItemGroup>
    <MSBuild Projects="@(BundledModSim);@(BundledModGame)" Targets="Build" BuildInParallel="false"
             Properties="Configuration=$(Configuration);BuildProjectReferences=false;BuildingBundledMods=true" />
    <!-- Built after the output's copy of mods/ was made: their code goes in now. -->
    <ItemGroup>
      <BundledModCode Include="..\..\mods\*\*.dll;..\..\mods\*\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(BundledModCode)" DestinationFiles="@(BundledModCode->'$(OutDir)mods\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- A published build carries the mods' code too (their data comes with the mods folder's other files). -->
  <Target Name="PublishBundledMods" AfterTargets="Publish">
    <ItemGroup>
      <BundledModPublish Include="..\..\mods\*\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(BundledModPublish)" DestinationFiles="@(BundledModPublish->'$(PublishDir)mods\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- BRUTAL License 1.0 and 4.0: BRUTAL's license and third-party notices go to licenses/ on build and publish. -->
  <Import Project="..\..\external\narsil\build\Narsil.Licensing.targets" />

</Project>
