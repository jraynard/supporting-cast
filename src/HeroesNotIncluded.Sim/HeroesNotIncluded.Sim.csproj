<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure simulation: no rendering or windowing dependencies. Only BRUTAL's math types. -->
  <ItemGroup>
    <PackageReference Include="Ahwoo.BRUTAL.Numerics" Version="2026.10.1" />
  </ItemGroup>

  <!-- Narsil's headless half (PRNG, DetMath, grid nav): no engine, so the sim stays headless. -->
  <ItemGroup>
    <ProjectReference Include="..\..\external\narsil\src\Narsil.Sim\Narsil.Sim.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HeroesNotIncluded.Sim.Tests" />
    <InternalsVisibleTo Include="HeroesNotIncluded.Tests" />
  </ItemGroup>

  <!-- Determinism as a compile error: the APIs a lockstep sim must never touch (docs/MODDING.md;
       the ModKit ships the same list for mods' sim halves). -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

</Project>
