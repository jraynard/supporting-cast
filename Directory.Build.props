<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Alpha builds: CI publishes each green push to main as release v$(Version); bump it to start a new one. -->
    <Version>0.0.1-alpha.1</Version>
    <!-- Same source, same bytes: co-op's build tag hashes the assemblies, so every platform's package
         must come out identical. CI also maps source paths so the checkout location doesn't matter. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
