  // Music by mood (src/HeroesNotIncluded/Audio/Sounds.cs, Moods). Tracks shuffle with a quiet gap
  // between. Our own songs go in music/ as <mood>_<name>.ogg (kept in git); the free placeholders
  // are fetched into music/free/ by tools/fetch_music.py (not kept in git).
  "music": {
    "title":    { "files": ["music/title_*.ogg", "music/free/title_*.ogg"], "gain": 0.8 },
    "day":      { "files": ["music/day_*.ogg", "music/free/day_*.ogg"], "gain": 0.6, "gap": [20, 60] },
    "night":    { "files": ["music/night_*.ogg", "music/free/night_*.ogg"], "gain": 0.5, "gap": [30, 90] },
    "danger":   { "files": ["music/danger_*.ogg", "music/free/danger_*.ogg"], "gain": 0.7, "gap": [2, 6] },
    "festival": { "files": ["music/festival_*.ogg", "music/free/festival_*.ogg"], "gain": 0.7, "gap": [4, 12] },
    "reveal":   { "files": ["music/reveal_*.ogg", "music/free/reveal_*.ogg"], "gain": 0.75, "gap": [6, 12] }
  }
