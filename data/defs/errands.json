    { "name": "Repair", "label": "a repair", "at": "Smithy", "priceMin": 5, "priceMax": 12, "patienceHours": 5,
      "lines": [ "My {1} has seen better days. {0} silver to whoever can mend it.", "Smith! My {1} needs work. {0} silver." ] },
    { "name": "Healing", "label": "healing", "at": "Clinic", "priceMin": 6, "priceMax": 15, "patienceHours": 4,
