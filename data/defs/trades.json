// Trades: the roles a round deals out. workPriorities change the AI's defaults for whoever holds
// the trade (1 highest, 4 lowest); only what the trade puts first is listed, so the town's other
// work still gets done. Labourer is unlimited: it's what's left when the named trades run out.
{
  "trades": [
    { "name": "Innkeeper", "label": "innkeeper", "description": "Keeps the longhouse fed and watered, and hears everything said over the bar.",
      "workplace": "Longhouse", "workPriorities": { "Cook": 1 } },
    { "name": "Blacksmith", "label": "blacksmith", "description": "Works the forge: blades, tools and repairs.",
      "workplace": "Smithy", "workPriorities": { "Craft": 1 } },
    { "name": "Healer", "label": "healer", "description": "Runs the clinic and patches up whoever is carried in.",
      "workplace": "Clinic", "workPriorities": { "Doctor": 1 } },
    { "name": "QuestBroker", "label": "quest broker", "description": "Matches parties to work from a corner of the longhouse, on whatever intelligence can be had.",
      "workplace": "Longhouse" },
    { "name": "Labourer", "label": "labourer", "description": "Hauls, chops and digs for anyone who'll pay.", "unlimited": true }
  ]
}
