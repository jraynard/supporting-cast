// Trades: the roles a round deals out. workPriorities change the AI's defaults for whoever holds
// the trade (1 highest, 4 lowest); only what the trade puts first is listed, so the town's other
// work still gets done. knows: stations whose recipes the holder knows; skills: the least they
// have; kit: what they start with; holdsKeys: a key to every lock at the workplace (the inn's storeroom). Labourer is unlimited: it's what's left when the named trades run out.
{
  "trades": [
    // The inn takes two: the innkeeper keeps the bar, the rooms and the quest board; the cook keeps
    // the kitchen. "serves": the services at the workplace a trade sees to (and prices on the sign).
    { "name": "Innkeeper", "label": "innkeeper", "description": "Keeps the bar and the rooms, hears everything said over the counter, and points adventuring parties at work, on whatever that's worth.",
      "workplace": "Inn", "workPriorities": { "Cook": 1 }, "brokers": true, "serves": [ "Drink", "MixedDrink", "Lodging", "Quest" ], "holdsKeys": true,
      "kit": [ { "def": "Mop" } ] },
    { "name": "Cook", "label": "cook", "description": "Keeps the inn's kitchen: the stew pot by taste, the larder, the bowls, and the meals out to the tables.",
      "workplace": "Inn", "workPriorities": { "Cook": 1 }, "serves": [ "Meal" ], "namesShop": false, "skills": { "Cooking": 5 },
      "kit": [ { "def": "Mop" } ] },
    { "name": "Blacksmith", "label": "blacksmith", "description": "Works the forge: blades, tools and repairs.",
      "workplace": "Smithy", "workPriorities": { "Craft": 1 },
      "knows": [ "Forge" ], "skills": { "Crafting": 6 },
      "kit": [ { "def": "Hammer" }, { "def": "Whetstone" }, { "def": "IronBar", "count": 6 }, { "def": "Wood", "count": 4 } ] },
    { "name": "Healer", "label": "healer", "description": "An empath: lays on hands to take others' wounds into themselves, then mends them with the gift.",
      "workplace": "Shrine", "workPriorities": { "Doctor": 1 }, "skills": { "Medicine": 6 }, "mana": 100,
      "kit": [ { "def": "Bandage", "count": 4 } ] },
    // The Carpenter is benched for now: building and fletching come back as a trade of its own later.
    { "name": "Tinker", "label": "tinker", "description": "Locks and clockwork: opens what adventurers drag home, fits locks and cuts keys, builds contraptions for the road, mends wagons and knows what a curio's worth.",
      "workplace": "TinkerShop", "workPriorities": { "Craft": 1 }, "skills": { "Crafting": 6, "Construction": 4 },
      "knows": [ "TinkerBench" ],
      "kit": [ { "def": "Lockpicks" }, { "def": "IronBar", "count": 4 }, { "def": "Wood", "count": 2 } ] },
    { "name": "Labourer", "label": "labourer", "description": "Hauls, chops and digs for anyone who'll pay.", "unlimited": true }
  ]
}
