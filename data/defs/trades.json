// Trades: the roles a round deals out. workPriorities change the AI's defaults for whoever holds
// the trade (1 highest, 4 lowest); only what the trade puts first is listed, so the town's other
// work still gets done. knows: stations whose recipes the holder knows; skills: the least they
// have; kit: what they start with (a weapon goes in hand); stash: what's kept for them at the workplace
// (under the bar), fetched when trouble comes; holdsKeys: a key to every lock at the workplace (the inn's storeroom). Labourer is unlimited: it's what's left when the named trades run out.
// stations: the trade's furniture at its workplace.
// The tutorial (the title menu's Tutorial, Scenarios/Lessons): tutorialIntro is what the trade's about,
// said first; lessons are its chapters, "core" ones run in order after the basics (below), the rest offered
// after. A step's "ui" is the action whose button glows while it's at hand (shop, inventory, gift, quests);
// "more" is shown once the player's been stuck on it a while; "notes" are the chapter's "worth knowing",
// shown when it's done. Words in the innkeeper's voice (docs in art/brand); keys as ~F~, ~AD~, ~J~...
// workplace: the town role of the building it works from (Tavern, Kitchen, Forge, Shrine, TinkerShop):
// which building that is is the map's to say (buildings.json "roles").
{
  // Every trade's tutorial starts here, unless the character's done it before.
  "basics": { "id": "basics", "title": "Finding your feet",
    "blurb": "Walking, your pack, your shop and the controls card.",
    "steps": [
      { "id": "move", "text": "Walk with ~WASD~. A few steps will do.",
        "more": "Your character is the one in the middle of the screen. The mouse turns the camera's aim; the walk keys move you." },
      { "id": "workplace", "text": "Now head to your workplace: follow the arrow.", "aside": true },
      { "id": "pack", "text": "Press ~Tab~ to open your pack: everything you carry. ~Tab~ again closes it.", "ui": "inventory" },
      { "id": "shop", "text": "Press ~J~ for your shop: what customers have asked of you, and the prices on your sign.", "ui": "shop",
        "more": "The Shop button at the top of the screen does the same." },
      { "id": "controls", "text": "Press ~H~ for the controls card. Every key is on it, any time. That's the basics: the rest is the trade." } ] },
  "trades": [
    // The innkeeper keeps the tavern (the bar, the rooms and the quest board), the cook the kitchen:
    // under one roof at Millbrook's inn, apart where a town has a cookhouse. "serves": the services at the workplace a trade sees to (and prices on the sign).
    // "wants": what an AI holder pins an errand for when its workplace has fewer than "below" of it
    // (Favours/Wants), "count" of them for "price" silver: the labourer's living.
    { "name": "Innkeeper", "label": "innkeeper", "description": "Keeps the bar and the rooms, hears everything said over the counter, and points adventuring parties at work, on whatever that's worth.",
      "workplace": "Tavern", "workPriorities": { "Cook": 1 }, "brokers": true, "serves": [ "Drink", "MixedDrink", "Lodging", "Quest" ], "holdsKeys": true,
      "stations": [ "AleCask", "BarShelf", "BarCounter", "BarTub", "KeyBoard" ],
      "tutorialIntro": "You keep the inn. Adventurers come in thirsty, tired and looking for work: you pour their drinks, rent them rooms and point them at quests. They pay in silver. They take the credit.",
      "lessons": [
        { "id": "ale", "title": "Pour an ale", "customers": "Thirsty", "core": true,
          "blurb": "Serve a customer an ale and get paid.",
          "steps": [
            { "id": "wait", "text": "Customers are on their way. They come to the bar to order; a ! over someone's head means they're waiting for you.",
              "more": "They walk in from the road, which takes a minute. The bubble over a head says what they're after." },
            { "id": "pour", "text": "Hold ~F~ at the ale cask to pour. ~AD~ tilts the tankard: tilted, it foams less but fills slower. Let go when it's full." },
            { "id": "give", "text": "Press ~F~ at the bar counter to hand it across to the customer waiting for it (or ~F~ at them). They pay once they have it.",
              "more": "The counter hands it to whoever's waited longest, your own orders first." } ],
          "notes": [ "Your prices hang on the sign (~J~). Too dear and they go thirsty. Too cheap and so do you.",
                     "A room: ~F~ at the key board behind the bar, write the guest into the book, take that room's key down and hand it over. The wrong key sends them in on someone.",
                     "When a guest's gone, their room wants turning round: clean linen from the storeroom on the bed (hold ~F~ to strip it, ~F~ as the sheet billows, ~A~ ~D~ to tuck), the pot into an empty bucket and out to the midden behind the inn, a bucket of water from the well into the jug.",
                     "No kitchen at your inn? ~F~ at the cookhouse hatch orders a hamper. Carry it back and unpack it on the warming shelf: your lodgers' board, and rations for the road.",
                     "Lucky Lou's under the bar. You'll know when. ~F~ at the counter." ] },
        { "id": "mixed", "title": "Mix a named drink", "supply": [ { "def": "Spirits" }, { "def": "Honey" } ],
          "blurb": "Mix a hearthwarmer (ale, spirits and honey) at the bar. The spirits and honey are in your pack.",
          "steps": [
            { "id": "tankard", "text": "Take a clean tankard from the shelf behind the bar (~F~)." },
            { "id": "mix", "text": "Press ~F~ at the bar counter and choose the hearthwarmer. Cues slide along the bar: press each one's key (~F~, ~A~ or ~D~) as it reaches the mark." } ] },
        { "id": "quest", "title": "Send a party on a quest", "customers": "Questing",
          "blurb": "Match a party to a quest. Too easy and they're insulted; too hard and they refuse.",
          "steps": [
            { "id": "wait", "text": "A party is on its way. One of them will ask you for work." },
            { "id": "offer", "text": "Click the one who asked while you're close, open the quests (~K~), and press \"Send them here\" on one that suits how strong they look. A quest isn't always what it seems.", "ui": "quests" } ] } ],
      "kit": [ { "def": "Mop" } ], "stash": [ { "def": "LuckyLou" } ] },
    { "name": "Cook", "label": "cook", "description": "Keeps the inn's kitchen: the stew pot by taste, the larder, the bowls, the meals out to the tables, and rations for the road.",
      "workplace": "Kitchen", "workPriorities": { "Cook": 1 }, "serves": [ "Meal", "Provisions" ], "namesShop": false, "skills": { "Cooking": 5 },
      "wants": [ { "thing": "Wood", "below": 6, "count": 10, "price": 5 }, { "thing": "Berries", "below": 4, "count": 8, "price": 4 },
                 { "thing": "Cabbage", "below": 3, "count": 6, "price": 4 } ],
      "stations": [ "StewPot", "Spit", "Oven", "Larder", "PrepTable", "ButcherBlock", "SmokingRack", "LogBasket", "ServingHatch", "WashTub" ],
      "tutorialIntro": "You keep the kitchen. Hungry adventurers order a meal at the serving hatch; you cook it, put it up, and they pay. The stew pot is most of the job. Nobody feeds the kitchen fires but you.",
      "lessons": [
        { "id": "stew", "title": "Cook a stew", "customers": "Trade", "restock": true, "core": true,
          "blurb": "Fill the pot, cook it, season it, and serve a bowl at the hatch.",
          "steps": [
            { "id": "larder", "text": "Take food from the larder (~F~). What goes in decides how it tastes.",
              "more": "Emberroot for heat, herbs to freshen. Diners say what they fancy." },
            { "id": "fill", "text": "Press ~F~ at the stew pot to put it in." },
            { "id": "fuel", "text": "The fire is out. Take logs from the basket by the door, then press ~F~ at the hearth.", "aside": true },
            { "id": "stir", "text": "Hold ~F~ at the pot to stir. Keep it at a simmer: let go if it starts to boil.",
              "more": "A fatty pot at a rolling boil spits. If the fat catches, clap the lid on (~Space~), quick." },
            { "id": "season", "text": "Add seasoning a pinch at a time (~F~) and taste with ~Space~. Salt can't be taken back out." },
            { "id": "wash", "text": "There are no clean bowls on the kitchen shelf. Wash dirty ones at the wash tub (~F~).", "aside": true },
            { "id": "ladle", "text": "Press ~F~ at the pot to ladle a bowl: it takes a clean one off the kitchen shelf." },
            { "id": "hatch", "text": "Put the bowl on the serving hatch (~F~)." },
            { "id": "served", "text": "Done. The customer at the front of the hatch line takes it." } ],
          "notes": [ "Bowls go out through the hatch and come back dirty. Heroes don't wash up. The wash tub's for that.",
                     "Oats in the pot make porridge, and porridge is what the morning wants. Put it on the sign (~J~).",
                     "Herbs and greens in the pot make a broth: the hurt mend faster on it, and it's good for a healer's gift.",
                     "Smell before it goes in (the larder's Smell button). A turned cabbage won't tell you. Your nose might.",
                     "A party back with nobody lost will call for a feast: a dish each at the hatch, against the clock.",
                     "Where the inn has no kitchen of its own, the innkeeper orders hampers at your hatch. Ladle a few bowls, pack them at the prep table and put the hamper up on the hatch.",
                     "A pot set roaring eats wood. The log basket's by the door." ] },
        { "id": "roast", "title": "Roast meat", "restock": true,
          "blurb": "Turn meat on the spit until every side is golden. How cooked it is inside doesn't show, so watch the time.",
          "steps": [
            { "id": "meat", "text": "Take raw meat from the larder (~F~)." },
            { "id": "fuel", "text": "The fire is out. Take logs from the basket by the door, then press ~F~ at the hearth.", "aside": true },
            { "id": "spit", "text": "Press ~F~ at the spit to put the meat on." },
            { "id": "turn", "text": "~F~ turns the meat; the side facing the fire browns. Turn it away from flare-ups. ~Space~ takes it off once every side is golden." } ],
          "notes": [ "Put roast on the sign (~J~) to be asked for it.",
                     "The carter brings pork by the side and birds in their feathers. Joint and pluck them at the butcher block (~F~).",
                     "Food keeps in the cool larder; left out in a warm kitchen it turns. Salt it at the prep table, or hang it on the smoking rack.",
                     "The kitchen knife's on you. If bandits come, it does more than onions. Not much more." ] },
        { "id": "bread", "title": "Bake bread", "restock": true,
          "blurb": "Knead two flour into dough, let it rise, then bake it. You judge the oven by smell.",
          "steps": [
            { "id": "flour", "text": "Take two flour from the larder." },
            { "id": "knead", "text": "At the prep table, knead: press ~A~ and ~D~ on the beat." },
            { "id": "prove", "text": "Leave the dough to rise for an hour or two of game time (too long and it sinks). Do something else meanwhile." },
            { "id": "fuel", "text": "The oven is cold. Take logs from the basket by the door, then press ~F~ at the oven.", "aside": true },
            { "id": "oven", "text": "Put the dough in the oven (~F~), and take it out when it smells of a golden crust, before it smells burnt." } ],
          "notes": [ "A ball of dough and two portions of raw food make a pie at the prep table: crimp the rim tight, or it leaks in the oven.",
                     "Chop at the prep table before the rush: draw your fingers back a slice (~A~), then chop (~F~). Chopped food cooks quicker. Forget your fingers and it's them you cut.",
                     "Three portions at the prep table make rations for the road. Set them down in the inn and put them up for sale." ] } ],
      "kit": [ { "def": "Mop" }, { "def": "KitchenKnife" } ] },
    { "name": "Blacksmith", "label": "blacksmith", "description": "Works the forge: blades, tools and repairs.",
      "workplace": "Forge", "workPriorities": { "Craft": 1 },
      "knows": [ "Forge" ], "skills": { "Crafting": 6 },
      "stations": [ "Forge", "Anvil", "Grindstone", "QuenchTub" ],
      "tutorialIntro": "You work the forge. Adventurers bring blades that have seen better days: you take the order, mend or sharpen the blade, hand it back and get paid. A dull edge goes to the grindstone; a chipped one to the forge and anvil first.",
      "lessons": [
        { "id": "sharpen", "title": "Sharpen a dull blade", "customers": "Dull", "core": true,
          "blurb": "Take a repair order, sharpen the blade at the grindstone, and give it back.",
          "steps": [
            { "id": "wait", "text": "Customers are on their way. One of them will want a blade sharpened.",
              "more": "They walk in from the road, which takes a minute. A hammer over someone's head means a repair." },
            { "id": "take", "text": "Take the order: open your shop (~J~) and press \"I'll do it\", or click the customer and press \"Take order\".", "ui": "shop" },
            { "id": "handover", "text": "Go to the customer (follow the arrow, or press \"Go and collect it\" on the order). They hand you the blade when you're close.", "ui": "shop" },
            { "id": "mend", "text": "This blade is chipped too. Open the forge (~F~) and press Mend.", "aside": true },
            { "id": "fuel", "text": "The forge is out. Take charcoal from the fuel bin, then press ~F~ at the forge.", "aside": true },
            { "id": "heat", "text": "Heat it: hold ~F~ to work the bellows, and press ~Space~ to take it out once it glows.", "aside": true },
            { "id": "hammer", "text": "At the anvil, hold ~F~ to raise the hammer to the mark, not past it, and let go to strike; ~A~ ~D~ keep it over the marker. Reheat it when the colour fades.", "aside": true },
            { "id": "grind", "text": "At the grindstone, hold ~F~ and keep the angle inside the band with ~AD~. Ease off before it overheats." },
            { "id": "giveback", "text": "Sharp. Press \"Take it back\" on the order (~J~) to walk over and return it. They check it, then pay.", "ui": "shop" } ],
          "notes": [ "Your prices hang on the sign (~J~). Every hero calls it robbery. Most pay anyway." ] },
        { "id": "mend", "title": "Mend a chipped blade", "customers": "Chipped", "supply": [ { "def": "IronBar", "count": 2 } ], "core": true,
          "blurb": "Hammer the chips out at the forge and anvil, then sharpen it. You have two spare iron bars.",
          "steps": [
            { "id": "wait", "text": "Customers are on their way. Their blades are chipped." },
            { "id": "take", "text": "Take the order: open your shop (~J~) and press \"I'll do it\", or click the customer and press \"Take order\".", "ui": "shop" },
            { "id": "handover", "text": "Go to the customer (follow the arrow, or press \"Go and collect it\" on the order). They hand you the blade when you're close.", "ui": "shop" },
            { "id": "mend", "text": "Open the forge (~F~) and press Mend. It uses one iron bar." },
            { "id": "fuel", "text": "The forge is out. Take charcoal from the fuel bin, then press ~F~ at the forge.", "aside": true },
            { "id": "heat", "text": "Heat it: hold ~F~ to work the bellows, and press ~Space~ to take it out once it glows orange." },
            { "id": "hammer", "text": "At the anvil, hold ~F~ to raise the hammer to the mark, not past it, and let go to strike; ~A~ ~D~ keep it over the marker. Reheat it when the colour fades: cold iron cracks.",
              "more": "Back to the forge whenever the glow's gone dull. A few heats is normal." },
            { "id": "grind", "text": "At the grindstone, hold ~F~ and keep the angle inside the band with ~AD~. Grinding a blade that's still chipped only wears it thin." },
            { "id": "giveback", "text": "Press \"Take it back\" on the order (~J~) to return it. If it's still chipped, they'll say so.", "ui": "shop" } ],
          "notes": [ "Your hammer's a weapon in a pinch. You can make yourself a better one. Nobody's stopping you." ] },
        { "id": "forge", "title": "Forge a sword", "supply": [ { "def": "IronBar", "count": 3 }, { "def": "Leather" } ],
          "blurb": "Make a short sword from iron bars: heat, hammer, quench, sharpen. The iron and leather are in your pack.",
          "steps": [
            { "id": "choose", "text": "Open the forge (~F~), choose iron and a shape (the short sword), and press Begin." },
            { "id": "fuel", "text": "The forge is out. Take charcoal from the fuel bin, then press ~F~ at the forge.", "aside": true },
            { "id": "heat", "text": "Heat it: hold ~F~ to work the bellows, and press ~Space~ to take it out once it glows orange. Left in too long, it burns." },
            { "id": "hammer", "text": "At the anvil, press ~F~ on the mark. A sword takes about a dozen good blows, over a few heats." },
            { "id": "quench", "text": "Quench it while it's hot: hold ~F~ to keep it under, and let go when the steam dies down. Too long makes it brittle; too short leaves it soft." },
            { "id": "grind", "text": "At the grindstone, hold ~F~ and keep the angle inside the band with ~AD~ until it's sharp." } ],
          "notes": [ "Three iron bars and a strip of leather make a short sword. Some hero will name it. You won't get a mention." ] },
        { "id": "smelt", "title": "Smelt iron and set prices", "restock": true,
          "blurb": "Smelt iron ore into bars, then change your prices on the sign.",
          "steps": [
            { "id": "ore", "text": "Take four iron ore from the chest (~F~). The carter keeps it filled." },
            { "id": "charcoal", "text": "Take two charcoal from the fuel bin." },
            { "id": "smelt", "text": "Open the forge (~F~) and press Smelt a bloom." },
            { "id": "fuel", "text": "The forge is out. Take charcoal from the fuel bin, then press ~F~ at the forge.", "aside": true },
            { "id": "fire", "text": "Hold ~F~ to work the bellows and keep the fire orange; yellow turns the iron to slag. Press ~Space~ to take the bloom out once it's large." },
            { "id": "beat", "text": "At the anvil, hold ~F~ to raise the hammer to the mark and let go, over the marker (~A~ ~D~), to beat out the slag and shape the bars." },
            { "id": "prices", "text": "Now open your shop (~J~) and change what a repair costs on the sign.", "ui": "shop" } ] } ],
      "kit": [ { "def": "Hammer" }, { "def": "Whetstone" }, { "def": "IronBar", "count": 2 }, { "def": "Leather", "count": 2 }, { "def": "Wood", "count": 4 } ] },
    { "name": "Healer", "label": "healer", "description": "An empath: lays on hands to take others' wounds into themselves, then mends them with the gift.",
      "workplace": "Shrine", "workPriorities": { "Doctor": 1 }, "skills": { "Medicine": 6 }, "mana": 100,
      "stations": [ "StrawPallet", "MeditationStone" ],
      "tutorialIntro": "You're an empath. The wounded come to the shrine, each with a heroic story. You lay hands on them, draw their wounds into yourself, then mend those wounds with your gift. It runs on mana, which you sit and win back.",
      "lessons": [
        { "id": "wound", "title": "Heal a wound", "patient": "Cut", "core": true,
          "blurb": "Feel for a patient's wound, draw it into yourself, then heal it with a mending.",
          "steps": [
            { "id": "feel", "text": "Stand by the patient, click them, and press \"Lay on hands\". Move your hands along them (~AD~) until you feel a warmth: your hands glow and the hum rises as you get close.",
              "more": "The patient's on a pallet in the shrine: follow the arrow. Lay on hands is also on the Gift (~Y~): click it, then click them." },
            { "id": "read", "text": "Stop on the warmth and hold ~F~ to read what it is. Don't hold ~F~ while moving: it hurts them." },
            { "id": "draw", "text": "Keep holding ~F~ to draw the wound into yourself. Keep the marker in the band with ~AD~. Let go to rest." },
            { "id": "meditate", "text": "Not enough mana to heal it. Go to the meditation stone, open the gift (~Y~) and press Meditate.", "aside": true, "ui": "gift" },
            { "id": "weave", "text": "Open the gift (~Y~) and press Weave beside the wound you carry. Your book lists the runes that heal it: key each one (1-6) as the ring meets the circle, then ~F~ to cast.", "ui": "gift" } ],
          "notes": [ "A bandage over someone's head means they want healing.",
                     "Several hurts? One sitting does them all: ~WS~ jumps to the next.",
                     "The shrine helps: weave at the rune altar (pain stirs your heart less), bind by the herb rack and the wash basin (a better dressing that won't fester). Point at anything to see what it's for.",
                     "The staff's for walking. And for keeping a raider at arm's length, plus a staff." ] },
        { "id": "many", "title": "Heal several wounds", "patientCase": "Many",
          "blurb": "Draw several wounds in one sitting. Each kind feels different under your hands. One is a fever, which spreads to anyone who stays near.",
          "steps": [
            { "id": "feel", "text": "Click the patient and press \"Lay on hands\". Move your hands (~AD~) to the first warmth." },
            { "id": "read", "text": "Hold ~F~ to read it. Each kind pulses its own way: a bruise swells, a burn pulls steadily, a fever rises and falls slowly." },
            { "id": "draw", "text": "Keep holding ~F~ to draw it, keeping the marker in the band (~AD~). Let go to rest if it slips." },
            { "id": "next", "text": "Keep your hands on them: ~WS~ jumps to the next warmth. Strain carries over, so rest a moment first." } ] },
        { "id": "festering", "title": "Find festering", "patientCase": "Festering",
          "blurb": "A dressing hides festering from a quick touch. Press longer to find it, then heal both.",
          "steps": [
            { "id": "feel", "text": "Click the patient and press \"Lay on hands\". Find the warmth on the arm (~AD~)." },
            { "id": "read", "text": "Stop on it and hold ~F~ to read it." },
            { "id": "deep", "text": "Keep holding. Under a dressing it takes a longer press to find the festering." },
            { "id": "draw", "text": "Found it. Keep holding ~F~ to draw it in, festering and all (~AD~ keeps the marker in the band)." },
            { "id": "meditate", "text": "Not enough mana to heal it. Go to the meditation stone, open the gift (~Y~) and press Meditate.", "aside": true, "ui": "gift" },
            { "id": "weave", "text": "Open the gift (~Y~) and Weave the wound you carry. Festering also needs a Cleansing: your book has its runes.", "ui": "gift" } ] },
        { "id": "shrine", "title": "Use the shrine", "patient": "Cut", "spent": true,
          "blurb": "The shrine helps you: get mana back at the meditation stone, bind wounds by the basin and herbs, and weave charms at the altar.",
          "steps": [
            { "id": "stone", "text": "You start with no mana. Go to the meditation stone." },
            { "id": "meditate", "text": "Open the gift (~Y~) and press Meditate. Move through the maze (~WASD~); hold ~F~ to stand still and see further. Each new place gives mana, the centre most.", "ui": "gift" },
            { "id": "corner", "text": "Stand at the foot of the patient's pallet, next to the wash basin and the herb rack. (Point at anything to see what it does.)" },
            { "id": "bind", "text": "Click the patient and press \"Bind their wounds\". Washed at the basin, the wound won't fester; the herbs make a better dressing." },
            { "id": "altar", "text": "Go to the rune altar, where pain disturbs your weaving less. Open the gift (~Y~) and press \"Weave a charm\".", "ui": "gift" },
            { "id": "show", "text": "Put the charm down in the shrine (~G~), click it, and set a price. Parties buy charms to take on quests." } ] } ],
      "kit": [ { "def": "Staff" }, { "def": "Bandage", "count": 4 } ] },
    // The Carpenter is benched for now: building and fletching come back as a trade of its own later.
    { "name": "Tinker", "label": "tinker", "description": "Locks and clockwork: opens what adventurers drag home, fits locks and cuts keys, builds contraptions for the road, mends wagons and knows what a curio's worth.",
      "workplace": "TinkerShop", "workPriorities": { "Craft": 1 }, "skills": { "Crafting": 6, "Construction": 4 }, "mendsTown": true,
      "wants": [ { "thing": "Wood", "below": 4, "count": 8, "price": 5 } ],
      "knows": [ "TinkerBench" ],
      "stations": [ "TinkerBench" ],
      "tutorialIntro": "You're the tinker. Strongboxes, curios and wagons that adventurers drag home end up with you: you open them, appraise them and mend them, for a fee. Your bench makes locks, keys and contraptions.",
      "lessons": [
        { "id": "box", "title": "Open a strongbox", "customers": "Trade", "core": true,
          "blurb": "Check a locked strongbox for traps, then pick its lock.",
          "steps": [
            { "id": "wait", "text": "Customers are on their way. One of them has a locked strongbox.",
              "more": "They walk in from the road, which takes a minute." },
            { "id": "take", "text": "Take the order: open your shop (~J~) and press \"I'll do it\", or click the customer and press \"Take order\".", "ui": "shop" },
            { "id": "handover", "text": "Go to the customer (follow the arrow, or press \"Go and collect it\" on the order). They hand you the box when you're close.", "ui": "shop" },
            { "id": "probe", "text": "Check for traps first: open your pack (~Tab~), right-click the box, and choose \"Feel for traps\". Run the probe along the seam with ~AD~, ~F~ let go. Where it catches, hold still for a good read, then hold ~F~ to press in and press ~Space~ while the needle's in the green.", "ui": "inventory",
              "more": "Fingers don't grow back. Feel it over before you pick it." },
            { "id": "pick", "text": "Then right-click the box again and choose \"Pick the lock\". Set each pin in turn.", "ui": "inventory" },
            { "id": "giveback", "text": "Open. Press \"Take it back\" on the order (~J~) to return it and get paid.", "ui": "shop" } ],
          "notes": [ "Strongboxes, wagons and curios also end up on your bench. Hold ~F~ there to start.",
                     "Your prices hang on the sign (~J~).",
                     "When raiders bring the bridge down, it's yours to mend: take 2 wood to the gap and press ~F~." ] },
        { "id": "curio", "title": "Appraise a curio", "customers": "Trade",
          "blurb": "Examine a curio and tell its owner what you think it's worth.",
          "steps": [
