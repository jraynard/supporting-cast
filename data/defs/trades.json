// Trades: the roles a round deals out. workPriorities change the AI's defaults for whoever holds
// the trade (1 highest, 4 lowest); only what the trade puts first is listed, so the town's other
// work still gets done. knows: stations whose recipes the holder knows; skills: the least they
// have; kit: what they start with (a weapon goes in hand); stash: what's kept for them at the workplace
// (under the bar), fetched when trouble comes; holdsKeys: a key to every lock at the workplace (the inn's storeroom). Labourer is unlimited: it's what's left when the named trades run out.
// stations: the trade's furniture at its workplace, marked for a new player till they've been to each;
// tips: first-day lines for a player new to it (short, plain, the innkeeper's voice: docs in art/brand).
{
  "trades": [
    // The inn takes two: the innkeeper keeps the bar, the rooms and the quest board; the cook keeps
    // the kitchen. "serves": the services at the workplace a trade sees to (and prices on the sign).
    { "name": "Innkeeper", "label": "innkeeper", "description": "Keeps the bar and the rooms, hears everything said over the counter, and points adventuring parties at work, on whatever that's worth.",
      "workplace": "Inn", "workPriorities": { "Cook": 1 }, "brokers": true, "serves": [ "Drink", "MixedDrink", "Lodging", "Quest" ], "holdsKeys": true,
      "stations": [ "AleCask", "Shelf", "BarCounter" ],
      "tips": [ "Thirsty adventurers come to the bar. The bubble over a head says what they're after; a ! means it's yours to pour.",
                "Hold ~F~ at the ale cask to pour. ~AD~ tilts the tankard: less foam, more patience.",
                "Your prices hang on the sign (~J~). Too dear and they go thirsty. Too cheap and so do you.",
                "Lucky Lou's under the bar. You'll know when. ~F~ at the counter." ],
      "lessons": [
        { "id": "ale", "title": "An ale", "customers": "Thirsty",
          "blurb": "A party in off the road with the dust still in their throats. Pour, hand it over, take their silver.",
          "steps": [
            { "id": "wait", "text": "A party's on its way in. They'll come to the bar and ask. A ! over a head means it's yours to pour." },
            { "id": "tankard", "text": "A clean tankard from the shelf behind the bar: ~F~ at it." },
            { "id": "pour", "text": "Hold ~F~ at the ale cask to pour. ~AD~ tilts the tankard: less foam, more patience. Let go when it's full." },
            { "id": "give", "text": "Click whoever asked, in reach, and hand it over. They pay when it's in their hand." } ] },
        { "id": "mixed", "title": "A named drink", "supply": [ { "def": "Spirits" }, { "def": "Honey" } ],
          "blurb": "A hearthwarmer: ale, spirits and honey, mixed to its cues at the bar. The spirits and honey are in your pack.",
          "steps": [
            { "id": "tankard", "text": "A clean tankard from the shelf behind the bar: ~F~ at it." },
            { "id": "mix", "text": "~F~ at the bar counter and pick the hearthwarmer. The cues come along the bar: press each (~F~, ~A~ or ~D~) as it reaches the mark." } ] },
        { "id": "quest", "title": "Sending a party", "customers": "Questing",
          "blurb": "Parties want work, and you hear of it. Match them to a quest that suits: too easy insults them, too hard and they won't go.",
          "steps": [
            { "id": "wait", "text": "A party's on its way in, settled enough to want work. One of them will ask you for it." },
            { "id": "offer", "text": "Click the one who asked, in reach, then the quests (~K~): \"Send them here\" on one that fits how strong they look. Whether it's what it seems is another matter." } ] } ],
      "kit": [ { "def": "Mop" } ], "stash": [ { "def": "LuckyLou" } ] },
    { "name": "Cook", "label": "cook", "description": "Keeps the inn's kitchen: the stew pot by taste, the larder, the bowls, the meals out to the tables, and rations for the road.",
      "workplace": "Inn", "workPriorities": { "Cook": 1 }, "serves": [ "Meal" ], "namesShop": false, "skills": { "Cooking": 5 },
      "stations": [ "StewPot", "Spit", "Oven", "Larder", "PrepTable", "ButcherBlock", "SmokingRack", "LogBasket", "ServingHatch", "WashTub" ],
      "tips": [ "The kitchen's yours. Fill the pot from the larder, then hold ~F~ at it to stir. A simmer, not a boil.",
                "Season a pinch at a time (~F~) and taste with ~Space~. Salt doesn't come back out.",
                "What goes in is what it tastes of. Emberroot for heat, herbs to freshen. Diners say what they fancy.",
                "Chop at the prep table before the rush (~F~ on the knife's beat). Chopped food cooks quicker. Mind your fingers.",
                "The spit's by the fire: meat on, ~F~ to turn it, ~Space~ to lift it. Golden all round. Put roast on the sign (~J~) to be asked for it.",
                "Two flour at the prep table knead into dough (~A~ ~D~ on the beat). Let it rise an hour or two, then the oven. Take it out on the golden crust.",
                "The carter brings pork by the side and birds in their feathers. Joint and pluck them at the butcher block (~F~).",
                "Oats in the pot make porridge, and porridge is what the morning wants. Put it on the sign (~J~).",
                "A ball of dough and two portions of raw food make a pie at the prep table: crimp the rim tight, or it leaks in the oven.",
                "A fatty pot at a rolling boil spits. If the fat catches, clap the lid on (~Space~), quick.",
                "Nobody feeds the kitchen fires but you. The log basket's by the door. A pot set roaring eats wood.",
                "Herbs and greens in the pot make a broth: the hurt mend faster on it, and it's good for a healer's gift.",
                "Food keeps in the cool larder; left out in a warm kitchen it turns. Salt it at the prep table, or hang it on the smoking rack.",
                "A party back with nobody lost will call for a feast: a dish each at the hatch, against the clock.",
                "Smell before it goes in (the larder's Smell button). A turned cabbage won't tell you. Your nose might.",
                "Three portions at the prep table make rations for the road. Set them down in the inn and put them up for sale.",
                "Bowls go out through the hatch and come back dirty. Heroes don't wash up. The wash tub's for that.",
                "The kitchen knife's on you. If bandits come, it does more than onions. Not much more." ],
      "lessons": [
        { "id": "stew", "title": "A stew", "customers": "Trade", "restock": true,
          "blurb": "From the larder to a hungry diner at the hatch: fill the pot, stir it to a simmer, season it, ladle a bowl.",
          "steps": [
            { "id": "larder", "text": "Food from the larder: ~F~ at it and take an armful (cabbage, meat, whatever you fancy it tasting of)." },
            { "id": "fill", "text": "~F~ at the stew pot to put it in." },
            { "id": "fuel", "text": "The fire's out. Logs from the basket by the door, then ~F~ at the hearth.", "aside": true },
            { "id": "stir", "text": "Hold ~F~ at the pot to stir. A simmer, not a boil: let go if it rolls." },
            { "id": "season", "text": "Season a pinch at a time (~F~) and taste with ~Space~. Salt doesn't come back out." },
            { "id": "wash", "text": "No clean bowls, only dirty ones. The wash tub: ~F~.", "aside": true },
            { "id": "bowl", "text": "A clean bowl from the kitchen shelf." },
            { "id": "ladle", "text": "~F~ at the pot to ladle a bowl." },
            { "id": "hatch", "text": "Put it up on the serving hatch: ~F~ at it." },
            { "id": "served", "text": "Up. Whoever's at the front of the hatch line takes it. Heroes don't wait well." } ] },
        { "id": "roast", "title": "A roast", "restock": true,
          "blurb": "A joint on the spit, turned golden all round. How far it's cooked through doesn't show: time and practice tell it.",
          "steps": [
            { "id": "meat", "text": "Raw meat from the larder: ~F~ at it." },
            { "id": "fuel", "text": "The fire's out. Logs from the basket by the door, then ~F~ at the hearth.", "aside": true },
            { "id": "spit", "text": "~F~ at the spit to put it on." },
            { "id": "turn", "text": "~F~ turns it; the side to the fire browns. Turn it off a flare. ~Space~ lifts it once every side's golden." } ] },
        { "id": "bread", "title": "Bread", "restock": true,
          "blurb": "Two flour kneaded to dough, proved an hour or two, and baked by smell alone.",
          "steps": [
            { "id": "flour", "text": "Two flour from the larder." },
            { "id": "knead", "text": "At the prep table: knead it, ~A~ and ~D~ on the beat." },
            { "id": "prove", "text": "Let it rise. It's slack now; it wants to be well risen, not puffed up and sunk. Go and do something else for an hour." },
            { "id": "fuel", "text": "The oven's cold. Logs from the basket by the door, then ~F~ at the oven.", "aside": true },
            { "id": "oven", "text": "Into the oven (~F~), and out on the smell of a golden crust. Toasty is fine. Burning is not." } ] } ],
      "kit": [ { "def": "Mop" }, { "def": "KitchenKnife" } ] },
    { "name": "Blacksmith", "label": "blacksmith", "description": "Works the forge: blades, tools and repairs.",
      "workplace": "Smithy", "workPriorities": { "Craft": 1 },
      "knows": [ "Forge" ], "skills": { "Crafting": 6 },
      "stations": [ "Forge", "Anvil", "Grindstone", "QuenchTub" ],
      "tips": [ "Adventurers bring blades that have seen better days. A hammer over a head means a repair.",
                "A dull edge goes to the grindstone. A chipped one to the forge, then the anvil. ~F~ does the work.",
                "The carter leaves iron ore in the chest. Smelt it at the forge: keep the fire orange, then beat the bloom on the anvil.",
                "Three iron bars and a strip of leather make a short sword. Some hero will name it. You won't get a mention.",
                "Your prices hang on the sign (~J~). Every hero calls it robbery. Most pay anyway.",
                "Your hammer's a weapon in a pinch. You can make yourself a better one. Nobody's stopping you." ],
      "lessons": [
        { "id": "sharpen", "title": "A dull blade", "customers": "Dull",
          "blurb": "A sellsword's edge has gone soft. Take the job, put an edge back on it at the grindstone, get paid.",
          "steps": [
            { "id": "wait", "text": "A party's on its way in. Their swordsman will want the edge seen to." },
            { "id": "take", "text": "Take the order: ~J~ and \"I'll do it\", or click the customer and \"Take order\"." },
            { "id": "handover", "text": "Go to them (the arrow points the way, or press \"Go and collect it\" on the order under ~J~): they hand the blade over once you're close." },
            { "id": "mend", "text": "It's chipped too. Open the forge (~F~) and press Mend.", "aside": true },
            { "id": "fuel", "text": "The forge has gone out. Charcoal from the fuel bin, then ~F~ at the forge.", "aside": true },
            { "id": "heat", "text": "Into the fire: hold ~F~ on the bellows, ~Space~ to draw it out once it glows.", "aside": true },
            { "id": "hammer", "text": "On the anvil: ~F~ as the hammer passes the mark. Back to the fire when the colour goes.", "aside": true },
            { "id": "grind", "text": "At the grindstone: hold ~F~, and keep the angle in the band with ~AD~. Ease off before it overheats." },
            { "id": "giveback", "text": "Keen again. \"Take it back\" on the order (~J~) walks you to them and hands it over. They'll check it before paying." } ] },
        { "id": "mend", "title": "A chipped blade", "customers": "Chipped", "supply": [ { "def": "IronBar", "count": 2 } ],
          "blurb": "Chips come out at the forge and anvil, and the edge goes on after. Two spare bars in your pack, for luck.",
          "steps": [
            { "id": "wait", "text": "A party's on its way in, their blades chipped from something with too many teeth." },
            { "id": "take", "text": "Take the order: ~J~ and \"I'll do it\", or click the customer and \"Take order\"." },
            { "id": "handover", "text": "Go to them (the arrow points the way, or press \"Go and collect it\" on the order under ~J~): they hand the blade over once you're close." },
            { "id": "mend", "text": "Open the forge (~F~) and press Mend. It costs a bar of iron." },
            { "id": "fuel", "text": "The forge has gone out. Charcoal from the fuel bin, then ~F~ at the forge.", "aside": true },
            { "id": "heat", "text": "Into the fire: hold ~F~ on the bellows, ~Space~ to draw it out once it glows orange." },
            { "id": "hammer", "text": "On the anvil: ~F~ as the hammer passes the mark. Back to the fire when the colour goes. Cold iron cracks." },
            { "id": "grind", "text": "The anvil flattens the edge. Grindstone: hold ~F~, keep the angle in the band with ~AD~. Grinding a blade that's still chipped only wears it thin." },
            { "id": "giveback", "text": "\"Take it back\" on the order (~J~) walks you to them and hands it over. Still chipped, and they'll tell you so." } ] },
        { "id": "forge", "title": "Something new", "supply": [ { "def": "IronBar", "count": 3 }, { "def": "Leather" } ],
          "blurb": "Bar to blade: the fire, the anvil, the quench and the edge. Enough iron and leather for a short sword.",
          "steps": [
            { "id": "choose", "text": "Open the forge (~F~), pick iron and a shape (the short sword, say), and Begin." },
            { "id": "fuel", "text": "The forge has gone out. Charcoal from the fuel bin, then ~F~ at the forge.", "aside": true },
            { "id": "heat", "text": "Into the fire: hold ~F~ on the bellows, ~Space~ to draw it out once it glows orange. Leave it in too long and it burns." },
            { "id": "hammer", "text": "On the anvil: ~F~ on the mark. A sword takes a dozen good blows, a few heats' worth." },
            { "id": "quench", "text": "Shaped. Quench it while it's hot: hold ~F~ to keep it under, let go when the steam dies down. Too long and it's brittle; too short and it's soft." },
            { "id": "grind", "text": "Grindstone: hold ~F~, keep the angle in the band with ~AD~, until it's keen." } ] },
        { "id": "smelt", "title": "Ore and prices", "restock": true,
          "blurb": "Iron doesn't come in bars. Smelt a bloom from ore, beat it out, then set what you charge.",
          "steps": [
            { "id": "ore", "text": "The carter's ore is in the chest. ~F~ at it and take four." },
            { "id": "charcoal", "text": "Two charcoal from the fuel bin, for the bloom." },
            { "id": "smelt", "text": "Open the forge (~F~) and Smelt a bloom." },
            { "id": "fuel", "text": "The forge has gone out. Charcoal from the fuel bin, then ~F~ at the forge.", "aside": true },
            { "id": "fire", "text": "Hold ~F~ on the bellows to keep it orange. Yellow runs the iron to slag. ~Space~ to draw it out once it's a fat bloom." },
            { "id": "beat", "text": "On the anvil: ~F~ on the mark to beat the slag out and the bars into shape." },
            { "id": "prices", "text": "Iron in hand. Now the sign: ~J~, and change what a repair costs. Everyone will call it robbery." } ] } ],
      "kit": [ { "def": "Hammer" }, { "def": "Whetstone" }, { "def": "IronBar", "count": 2 }, { "def": "Leather", "count": 2 }, { "def": "Wood", "count": 4 } ] },
    { "name": "Healer", "label": "healer", "description": "An empath: lays on hands to take others' wounds into themselves, then mends them with the gift.",
      "workplace": "Shrine", "workPriorities": { "Doctor": 1 }, "skills": { "Medicine": 6 }, "mana": 100,
      "stations": [ "StrawPallet", "MeditationStone" ],
      "tips": [ "The wounded find their way to the shrine, each with a heroic story. A bandage over a head means they want healing.",
                "Lay on hands: skim for a warmth, stop and press to read it, keep pressing to draw it. Several hurts? One sitting does them all: ~WS~ jumps to the next.",
                "Your gift runs on mana (~Y~). Sit a while at the meditation stone to fill it back up.",
                "The staff's for walking. And for keeping a raider at arm's length, plus a staff." ],
      "lessons": [
        { "id": "wound", "title": "A wound", "patient": "Cut",
          "blurb": "Torvi's on a pallet again. Feel the wound over, draw it into yourself, and mend it with the gift.",
          "steps": [
            { "id": "feel", "text": "Stand by Torvi, click them, and \"Lay on hands\". Run your hands along them (~AD~) until you feel a warmth." },
            { "id": "read", "text": "Something's there. Stop on it and hold ~F~: what it is comes through your hands. Don't press while you move; it's rough on them." },
            { "id": "draw", "text": "You know it now. Keep holding ~F~ to draw it in, and keep your composure in the band (~AD~). It's yours now, and it hurts." },
            { "id": "meditate", "text": "Too little mana to mend it. At the meditation stone, open the gift (~Y~) and Meditate.", "aside": true },
            { "id": "weave", "text": "Open the gift (~Y~): Weave the wound you carry. Key the runes your book gives for how it feels, each on a heartbeat. ~F~ lets it go." } ] },
        { "id": "fever", "title": "A fever", "patient": "Fever",
          "blurb": "Nothing to see, and it spreads to whoever lingers. Torvi has one. Draw it in and mend it before it finds you the slow way.",
          "steps": [
            { "id": "feel", "text": "Stand by Torvi, click them, and \"Lay on hands\". A fever's in the chest: run your hands up to its warmth (~AD~)." },
            { "id": "read", "text": "Stop on it and hold ~F~. A fever swells and ebbs under your hands, slow and heavy." },
            { "id": "draw", "text": "Keep holding ~F~ to draw it in, and keep your composure in the band (~AD~) as it swells." },
            { "id": "meditate", "text": "Too little mana to mend it. At the meditation stone, open the gift (~Y~) and Meditate.", "aside": true },
            { "id": "weave", "text": "Open the gift (~Y~) and Weave it. The fever's feel wants its own runes: the book has them." } ] },
        { "id": "meditate", "title": "Mana", "spent": true,
          "blurb": "The gift runs dry. Win it back at the meditation stone: a labyrinth inward, every new place a little more.",
          "steps": [
            { "id": "stone", "text": "Your mana's spent. Go to the meditation stone; it's calmer there." },
            { "id": "meditate", "text": "Open the gift (~Y~) and Meditate. Find your way inward (~WASD~); hold ~F~ to be still and see further. The centre gives the most." } ] } ],
      "kit": [ { "def": "Staff" }, { "def": "Bandage", "count": 4 } ] },
    // The Carpenter is benched for now: building and fletching come back as a trade of its own later.
    { "name": "Tinker", "label": "tinker", "description": "Locks and clockwork: opens what adventurers drag home, fits locks and cuts keys, builds contraptions for the road, mends wagons and knows what a curio's worth.",
      "workplace": "TinkerShop", "workPriorities": { "Craft": 1 }, "skills": { "Crafting": 6, "Construction": 4 }, "mendsTown": true,
      "knows": [ "TinkerBench" ],
      "stations": [ "TinkerBench" ],
      "tips": [ "Strongboxes, wagons and curios end up on your bench. Hold ~F~ there to start.",
                "Feel a strongbox over for traps before you pick it. Fingers don't grow back.",
                "When raiders bring the bridge down, it's yours to mend: take 2 wood to the gap and press ~F~.",
                "Your prices hang on the sign (~J~). A curio's worth what you say it is. Mostly.",
                "A dagger won't hold off a raid. A crossbow from your bench might: two iron bars and some wood." ],
      "lessons": [
        { "id": "box", "title": "A strongbox", "customers": "Trade",
          "blurb": "Adventurers drag home locked boxes and don't ask what's inside the lock. Feel it over, then pick it.",
          "steps": [
            { "id": "wait", "text": "A party's on its way in, one of them with a locked strongbox." },
            { "id": "take", "text": "Take the order: ~J~ and \"I'll do it\", or click the customer and \"Take order\"." },
            { "id": "handover", "text": "Go to them (the arrow points the way, or \"Go and collect it\" on the order under ~J~): they hand it over once you're close." },
            { "id": "probe", "text": "Feel it over for traps first: open your pack (~Tab~), click the box, \"Feel for traps\". ~AD~ runs the probe along the seam; where it catches, hold ~F~ to ease the spring out. Fingers don't grow back." },
            { "id": "pick", "text": "Now \"Pick the lock\", from the same menu: set each pin in turn." },
            { "id": "giveback", "text": "Open. \"Take it back\" on the order (~J~) walks you to them; they take out their silver and pay." } ] },
        { "id": "curio", "title": "A curio", "customers": "Trade",
          "blurb": "Something old and odd, and a hero who wants to know what it's worth. Look it over, and tell them.",
          "steps": [
            { "id": "wait", "text": "A party's on its way in, one of them with a curio." },
            { "id": "take", "text": "Take the order: ~J~ and \"I'll do it\", or click the customer and \"Take order\"." },
            { "id": "handover", "text": "Go to them (the arrow points the way, or \"Go and collect it\" on the order under ~J~): they hand it over once you're close." },
            { "id": "appraise", "text": "Open your pack (~Tab~), click the curio, \"Look it over under the loupe\". ~AD~ moves the loupe; where the eye catches, hold ~F~ still. What you make of it is yours, not the truth." },
            { "id": "giveback", "text": "\"Take it back\" on the order (~J~), and tell them what you think it's worth." } ] },
        { "id": "lock", "title": "A lock and key",
          "blurb": "Pin a lock from an iron bar, file its key, and fit it to your own door.",
          "steps": [
            { "id": "pin", "text": "Hold ~F~ at the bench and pick the lock. Set each pin as it comes; the first key is filed to match." },
            { "id": "fit", "text": "A lock and its key. ~F~ at the shop's door and fit it." },
            { "id": "turn", "text": "Fitted. ~F~ at the door and lock it with your key." } ] },
        { "id": "crossbow", "title": "A crossbow", "supply": [ { "def": "Wood", "count": 3 } ],
          "blurb": "A stock, a steel bow and a trigger, fitted together and spanned. Better than a dagger when the bandits come.",
          "steps": [
            { "id": "choose", "text": "Hold ~F~ at the bench and pick the crossbow." },
            { "id": "fit", "text": "Fit each part as it lines up, then wind the string back to the nut." } ] } ],
      "kit": [ { "def": "Dagger" }, { "def": "Lockpicks" }, { "def": "IronBar", "count": 4 }, { "def": "Wood", "count": 2 } ] },
    { "name": "Labourer", "label": "labourer", "description": "Hauls, chops and digs for anyone who'll pay.", "unlimited": true, "gathers": true }
  ]
}
