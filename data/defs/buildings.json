{
  // Preset buildings (Systems/Buildings.cs, docs/plans/preset-buildings.md): a plan raised in
  // phases (foundation, walls, roof, furniture), each phase laying its parts as blueprints once
  // the one before is built. Layout rows run from the back (-Y) to the front (+Y, where R turns
  // the front): W wall, D door, P post, S stair, . inside, space for nothing. Every plot cell gets
  // the foundation, and the roof a level above the top storey. "upperLayout" is a second storey
  // over the first (its cells above a stair stay open); "level": 1 puts furniture or a slot up there. Foundation, walls and roof each go up as one site
  // (several villagers at once); "furnish" puts furniture in piece by piece at plan cells
  // [column, row]. "slots" are the spots for extras once it's finished: each takes one of its
  // defs, at its cell and facing (added to the building's). A variant swaps parts for another look.
  "buildings": [
    {
      "name": "Dwelling", "label": "dwelling", "icon": "buildings/bed",
      "description": "A small house of logs with a hearth and a bed. Spots inside for two more beds and two chests (or a stool): each bed brings a settler.",
      "layout": [
        "WWWWWW",
        "W....W",
        "W....W",
        "W....W",
        "WWDWWW"
      ],
      "parts": { "foundation": "Sill", "wall": "LogWall", "door": "PlankDoor", "roof": "TurfRoofPart" },
      "furnish": [
        { "def": "Bed", "at": [1, 1] },
        { "def": "Hearth", "at": [3, 2] }
      ],
      "slots": [
        { "defs": ["Bed", "StrawPallet"], "at": [2, 1] },
        { "defs": ["Bed", "StrawPallet"], "at": [4, 1] },
        { "defs": ["Chest"], "at": [1, 3], "facing": 2 },
        { "defs": ["Chest", "Stool"], "at": [4, 3], "facing": 2 }
      ],
      "upgrades": [
        {
          "name": "CookingPot", "label": "cooking pot", "on": "Hearth", "work": 120,
