// The practice yard's fighting corner (Scenarios/Sparring): the tutorial's combat chapter sets these
// out near the player. The dummy is a "target": a melee blow that strikes nobody lands in it
// (Combat/Reach.TargetInSweep), and it takes no hurt. Its sparring partner's lines are below.
{
  "things": [
    {
      // A straw man on a post, arms out on a crossbar: something to hit that doesn't hit back.
      "name": "TrainingDummy", "label": "training dummy", "category": "Building", "solid": true, "sprite": "props/straw",
      "description": "A sack of straw on a post with a crossbar for arms. It's been punched more than anyone in town, and complains less.",
      "maxHp": 100, "flammability": 1.0,
      "building": { "buildable": false, "outdoor": true, "target": true, "work": 60, "cost": [ { "def": "Planks", "count": 2 } ] },
      "model": [
        { "min": [0.46, 0.46, 0], "max": [0.54, 0.54, 1.75], "top": "props/timber_dark", "side": "props/timber_dark" },
        { "min": [0.3, 0.38, 0], "max": [0.7, 0.62, 0.08], "top": "props/timber_dark", "side": "props/timber_dark" },
        { "min": [0.3, 0.36, 0.7], "max": [0.7, 0.64, 1.35], "top": "props/straw", "side": "props/straw" },
        { "min": [0.08, 0.45, 1.18], "max": [0.92, 0.55, 1.26], "top": "props/timber_dark", "side": "props/timber_dark" },
        { "min": [0.06, 0.42, 1.08], "max": [0.18, 0.58, 1.3], "top": "props/straw", "side": "props/straw" },
        { "min": [0.82, 0.42, 1.08], "max": [0.94, 0.58, 1.3], "top": "props/straw", "side": "props/straw" },
        { "min": [0.39, 0.41, 1.38], "max": [0.61, 0.59, 1.62], "top": "props/straw", "side": "props/straw" }
      ]
    }
  ],
  "barks": [
    { "name": "spar_hello", "lines": [
      { "text": "Hit the dummy first. Then me, if you're feeling brave." },
      { "text": "Warm up on the straw. I'll be here." } ] },
    { "name": "spar_ready", "lines": [
      { "text": "Fists up, then." },
      { "text": "Right. Watch my shoulder, not my face." },
      { "text": "Bare knuckles, nothing fancy. Ready?" } ] },
    { "name": "spar_done", "lines": [
      { "text": "That'll do. Get your breath." },
      { "text": "Enough for now. You'll feel that tomorrow." } ] }
  ]
