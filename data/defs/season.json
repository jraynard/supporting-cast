// A round's season (Defs/SeasonDefs.cs). It runs `days` days from the deal, and the festival
// starts at `festivalHour` on the last of them; `festivalHours` later the town's Renown is reckoned
// against `renownTarget` and the round is over. Dread reaching `dreadLimit` ends it sooner, lost.
// Renown comes from adventurers leaving town (their satisfaction, clamped to satisfactionRange,
// times renownPerSatisfaction) and quests cleared; Dread from quests left unanswered (per quest
// per game hour), failed or deadly, and eases when one is cleared. Crises met or not move both.
// Tune in play.
{
  "seasons": [
    {
      "name": "Season",
      "startingPurse": 12,
      "days": 3,
      // From 15:00 to 22:30 on the last day at most (festival.json): about five real minutes, less
      // if the ceremony's said its piece sooner. The tale and the ceremony take what reading them
      // takes. Not much later: the town starts going to bed, crier and all.
      // From festivalSetupHour that day the labourers put the festival up in the square.
      "festivalSetupHour": 11,
      "festivalHour": 15,
      "festivalHours": 7.5,
      "renownTarget": 60,
      "dreadLimit": 100,
      "renownPerSatisfaction": 1,
      "satisfactionRange": [ -5, 10 ],
      "renownPerQuestCleared": 10,
      "renownPerAdventurerLost": -4,
      "dreadPerOpenQuestHour": 0.4,
      "dreadPerQuestFailed": 12,
      "dreadPerAdventurerLost": 3,
      // One of the town's own dying, and coming back (Afterlife/).
      "dreadPerTownDeath": 5,
      "dreadPerRevival": -3,
      "dreadPerQuestCleared": -12,
      // The Director's crises (Director/Director.cs): one per beat, at a time in the window (sooner
      // the more Dread), of a kind picked by weight. Kinds not built yet are passed over.
      "crisisMetRenown": 6,
      "crisisMetDread": -4,
      "crisisUnmetDread": 10,
      "dragonMetRenown": 20,
      "dragonUnmetDread": 20,
      "crisisHours": 6,
      // Raid points (storyteller.json's formula) times this: at 0.85 a town of six meets a bandit or
      // two on the first evening and three on the second day. Left to itself the town loses that
      // one (at 1 it was wiped out): it needs its players. At 1.6 the combat sweep's sixteen
      // seeds meet about ten raids with heroes in town and five without (CombatBalanceTests).
      "raidPointsFactor": 1.6,
      "raidBreaksBridge": 0.6,
      "dreadPerBreachHour": 0.5,
      // Word of a raid comes this many game hours ahead (Director/Director.cs), and the town calls
      // for arms (Militia/Militia.cs): it pays armsPrice silver from townPurse for each new weapon
      // hung on the muster rack, as many as it has unarmed folk (up to armsWanted).
      "raidWarningHours": 5,
      "townPurse": 40,
      "armsPrice": 6,
      "armsWanted": 6,
      // What the carter leaves at the smithy each morning from the second day (Shops/Deliveries.cs).
      "oreDelivery": [ { "def": "IronOre", "count": 12 }, { "def": "Charcoal", "count": 10 }, { "def": "Wood", "count": 4 } ],
      // Timber for building and mending: barnWood in the barn's stockpile at the deal, woodDelivery
      // left there each morning from the second day. The carpenter's logs come from felling.
      "barnWood": 100,
      "woodDelivery": [ { "def": "Wood", "material": "Pine", "count": 30 } ],
      // Firewood for the town's fires (about ten of them, a dozen billets a day each): barnFirewood at
      // the deal, firewoodDelivery each morning from the second day (none in a shortage). A little
      // short of the season's burning on purpose: the carpenter splits logs to make it up.
      "barnFirewood": 150,
      "firewoodDelivery": [ { "def": "Firewood", "material": "Pine", "count": 100 } ],
      // Goose feathers for the carpenter's arrows, left in the woodshop's chest with the ore.
      "woodshopDelivery": [ { "def": "Feathers", "count": 6 } ],
      // How the Director paces it (Director/Tension.cs, Director/RuleMind.cs): it eases off a town
      // that's struggling and pushes one that's coasting, against where a town on course would be
      // (renownAtFestival of the target by the festival; the rest comes at its end). A beat waits in
      // its window for the town to be calm (harm under calmHarm, nothing under way) and settles its
      // kind a raid's warning ahead, weighed by what's been seen and who'd answer it (answers: the
      // town role whose trade meets each kind; a player there counts playerWeight, nobody able
      // nobodyWeight). In a lull (lullHours quiet), an incident (incidents.json).
      "pacing": {
        "renownAtFestival": 0.6,
        "strengthRange": [ 0.75, 1.35 ],
        "calmHarm": 0.35,
        "lullHours": 3,
        "incidentGapHours": 4,
        "beatClearHours": 3,
        "incidentPushFloor": -0.25,
        "seenWeight": 0.4,
        "playerWeight": 1.5,
        "nobodyWeight": 0.25,
        "answers": { "Raid": "Forge", "Shortage": "Kitchen", "Plague": "Shrine" }
      },
      // A beat may follow a quest instead ("followsQuest": a quest's name, "afterHours": [earliest,
      // latest] after its party sets out, "replaces": another beat's "id", "omen": what the town
      // hears then): it comes only if a party goes, and never into the festival.
      "beats": [
        { "day": 1, "fromHour": 20, "toHour": 23, "strength": 0.5, "kinds": { "Raid": 1 } },
        { "day": 2, "fromHour": 10, "toHour": 17, "strength": 1, "kinds": { "Raid": 3, "Fire": 2, "Shortage": 2, "Plague": 2 } },
        // The dragon on the last morning: gone (DragonCrisis.Hours) and its fires out before the
        // festival goes up at festivalSetupHour, never into it (DirectorTests checks).
        { "day": 3, "fromHour": 6, "toHour": 8, "strength": 1.2, "kinds": { "Dragon": 1 } }
      ]
    }
  ]
}
