// A round's season (Defs/SeasonDefs.cs). It runs `days` days from the deal, and the festival
// starts at `festivalHour` on the last of them; `festivalHours` later the town's Renown is reckoned
// against `renownTarget` and the round is over. Dread reaching `dreadLimit` ends it sooner, lost.
// Renown comes from adventurers leaving town (their satisfaction, clamped to satisfactionRange,
// times renownPerSatisfaction) and quests cleared; Dread from quests left unanswered (per quest
// per game hour), failed or deadly, and eases when one is cleared. Crises met or not move both.
// Tune in play.
{
  "seasons": [
    {
      "name": "Season",
      "startingPurse": 12,
      "days": 3,
      "festivalHour": 18,
      "festivalHours": 2,
      "renownTarget": 60,
      "dreadLimit": 100,
      "renownPerSatisfaction": 1,
      "satisfactionRange": [ -5, 10 ],
      "renownPerQuestCleared": 10,
      "renownPerAdventurerLost": -4,
      "dreadPerOpenQuestHour": 0.4,
      "dreadPerQuestFailed": 12,
      "dreadPerAdventurerLost": 3,
      "dreadPerQuestCleared": -12,
      // The Director's crises (Director/Director.cs): one per beat, at a time in the window (sooner
      // the more Dread), of a kind picked by weight. Kinds not built yet are passed over.
      "crisisMetRenown": 6,
      "crisisMetDread": -4,
      "crisisUnmetDread": 10,
      "crisisHours": 6,
      "raidPointsFactor": 0.4,
      "beats": [
        { "day": 1, "fromHour": 20, "toHour": 23, "strength": 0.5, "kinds": { "Raid": 1 } },
        { "day": 2, "fromHour": 10, "toHour": 17, "strength": 1, "kinds": { "Raid": 3, "Fire": 2, "Shortage": 2, "Plague": 2 } },
        { "day": 3, "fromHour": 11, "toHour": 15, "strength": 1.2, "kinds": { "Dragon": 1 } }
      ]
    }
  ]
}
