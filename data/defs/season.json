// A round's season (Defs/SeasonDefs.cs). It runs `days` days from the deal, and the festival
// starts at `festivalHour` on the last of them; `festivalHours` later the town's Renown is reckoned
// against `renownTarget` and the round is over. Dread reaching `dreadLimit` ends it sooner, lost.
// Renown comes from adventurers leaving town (their satisfaction, clamped to satisfactionRange,
// times renownPerSatisfaction) and quests cleared; Dread from quests left unanswered (per quest
// per game hour), failed or deadly, and eases when one is cleared. Crises met or not move both.
// Tune in play.
{
  "seasons": [
    {
      "name": "Season",
      "startingPurse": 12,
      "days": 3,
      // From 15:00 to 22:30 on the last day at most (festival.json): about five real minutes, less
      // if the ceremony's said its piece sooner. The tale and the ceremony take what reading them
      // takes. Not much later: the town starts going to bed, crier and all.
      // From festivalSetupHour that day the carpenter puts the festival up in the square (whatever's left goes up at the bell).
      "festivalSetupHour": 11,
      "festivalHour": 15,
      "festivalHours": 6.5,
      "renownTarget": 60,
      "dreadLimit": 100,
      "renownPerSatisfaction": 1,
      "satisfactionRange": [ -5, 10 ],
      "renownPerQuestCleared": 10,
      "renownPerAdventurerLost": -4,
      "dreadPerOpenQuestHour": 0.4,
      "dreadPerQuestFailed": 12,
      "dreadPerAdventurerLost": 3,
      // One of the town's own dying, and coming back (Afterlife/).
      "dreadPerTownDeath": 5,
      "dreadPerRevival": -3,
      "dreadPerQuestCleared": -12,
      // The Director's crises (Director/Director.cs): one per beat, at a time in the window (sooner
      // the more Dread), of a kind picked by weight. Kinds not built yet are passed over.
      "crisisMetRenown": 6,
      "crisisMetDread": -4,
      "crisisUnmetDread": 10,
      "dragonMetRenown": 20,
      "dragonUnmetDread": 20,
      "crisisHours": 6,
      // A brawl at the inn (Hospitality/BrawlCrisis): a rowdy crowd ("crowd" parties) comes in loud
      // with drink. Heat climbs risePerHour for every perBrawlers still at it and eases coolPerHour;
      // at 1 it boils over (not met). Settling the ringleader takes ringleaderCools off.
      "brawl": { "risePerHour": 0.4, "perBrawlers": 4, "coolPerHour": 0.1, "ringleaderCools": 0.3,
        "arriveTipsy": 0.55, "joinTipsy": 0.5, "crowd": 4, "sourSatisfaction": -3,
        // From breakAt, each turn a brawler may (smashChance) take it out on a table or a stool
        // ("breaksInBrawls" furniture) instead: blowsToBreak and it's matchwood, the carpenter's to make again.
        "breakAt": 0.4, "smashChance": 0.2, "blowsToBreak": 3,
        // Past breakAt, too: a stool grabbed and hurled (throwChance a turn; "thrownInBrawls"), and a
        // punch that sends them into the table behind (shoveChance) hits it twice over.
        "throwChance": 0.15, "shoveChance": 0.35,
        // Boiling over, a lamp may go over (fireOnBoil): the inn's alight as well, a fire to meet of its own.
        "fireOnBoil": 0.35,
        // Other ways to settle it: a bucket of well water over a brawler takes douseSobers of drink off
        // (under clumsy, they're out of it); a tune calms (a sour one riles) musicPerHour for every
        // perBrawlers who hear it, and a reel they can dance to turns one into a dancer (danceChance a
        // look); "Drinks on the house!" costs the keeper drinksCost a brawler.
        "douseSobers": 0.35, "musicPerHour": 0.4, "danceChance": 0.35, "drinksCost": 2,
        // A player's fists in the inn (Hospitality/Patience.cs): a guest puts up with tolerance punches (a haymaker is
        // two, the rowdy or loud one fewer), forgetting one every grudgeFadeSeconds, then hits back, and that's a brawl
        // (no Renown for settling one you started). With onlookersJoinAt fighting, rowdy or drunk onlookers join, about
        // onlookerJoinPerHour each; a brawler with nobody to hit gives up after coolOffSeconds.
        "tolerance": 3, "grudgeFadeSeconds": 20, "onlookersJoinAt": 2, "onlookerJoinPerHour": 1.5, "coolOffSeconds": 25 },
      // Raid points (storyteller.json's formula) times this: at 0.85 a town of six meets a bandit or
      // two on the first evening and three on the second day. Left to itself the town loses that
      // one (at 1 it was wiped out): it needs its players. At 1.6 the combat sweep's sixteen
      // seeds meet about ten raids with heroes in town and five without (CombatBalanceTests).
      "raidPointsFactor": 1.6,
      // An AI villager counts this much of a character a player's playing toward a raid's size: raids grow with the players
      // (bots in the sweep are players, so it's unchanged by this). A solo town of seven AI is sized as about 4.5 people.
      "raidAiShare": 0.5,
      "raidBreaksBridge": 0.6,
      "dreadPerBreachHour": 0.5,
      // Word of a raid comes this many game hours ahead (Director/Director.cs), and the town calls
      // for arms (Militia/Militia.cs): it pays armsPrice silver from townPurse for each new weapon
      // hung on the muster rack, as many as it has unarmed folk (up to armsWanted).
      "raidWarningHours": 5,
      "townPurse": 40,
      "armsPrice": 6,
      "armsWanted": 6,
      // The shops' ore, kegs, food, cloth and feathers come to order (supplies.json, Shops/CarterOrders.cs):
      // what a player orders, or a shop the AI runs keeps in by its trade's standing orders.
      // In the smithy's chest at the deal, beside its iron ore and planks: bronze for the first pieces asked for in it,
      // and copper and tin to alloy more.
      "smithyStock": [ { "def": "BronzeBar", "count": 4 }, { "def": "CopperOre", "count": 8 }, { "def": "TinOre", "count": 4 } ],
      // Of anything a player's trade brings the town itself (a trade's "supplies": the miner's ore), the
      // carter brings only this share while they're in the round.
      "suppliedShare": 0.25,
      // Timber for building and mending: barnWood in the barn's stockpile at the deal, woodDelivery
      // left there each morning from the second day. The carpenter's logs come from felling.
      "barnWood": 100,
      // Planks in the barn at the deal, for what the town makes (hafts, contraptions, furniture) till the
      // carpenter saws more: timber is for building and mending.
      "barnPlanks": 40,
      // Charcoal in the smithy's fuel bin at the deal: a day and a half's firing, so a smith new to the trade
      // finds the kiln before the forge goes cold. Cloth in the shrine's basket, for bandages.
      "smithyCharcoal": 45,
      // Firewood in the smithy's bin for the kiln, and how many days of their fires' burning every other
      // workplace's own fuel store opens with (Work.FuelStores); the carter or the carpenter brings more to order.
      "smithyFirewood": 30,
      "workplaceFuelDays": 1.5,
      "shrineCloth": 6,
      "woodDelivery": [ { "def": "Wood", "material": "Pine", "count": 30 } ],
      // Firewood for the homes' hearths (seven to nine cottages, a dozen billets a day each; a workplace keeps
      // its own, workplaceFuelDays, and may not burn the barn's): barnFirewood at the deal, firewoodDelivery each
      // morning from the second day (none in a shortage). Kept as it was when the workplaces drew on it too:
      // cut to the homes' bare needs, the raid sweep's balance moved (CombatBalanceTests).
      "barnFirewood": 150,
      "firewoodDelivery": [ { "def": "Firewood", "material": "Pine", "count": 100 } ],
      // How the Director paces it (Director/Tension.cs, Director/RuleMind.cs): it eases off a town
      // that's struggling and pushes one that's coasting, against where a town on course would be
      // (renownAtFestival of the target by the festival; the rest comes at its end). A beat waits in
      // its window for the town to be calm (harm under calmHarm, nothing under way) and settles its
      // kind a raid's warning ahead, weighed by what's been seen and who'd answer it (answers: the
      // town role whose trade meets each kind; a player there counts playerWeight, nobody able
      // nobodyWeight). In a lull (lullHours quiet), an incident (incidents.json).
      "pacing": {
        "renownAtFestival": 0.6,
        "strengthRange": [ 0.75, 1.35 ],
        "calmHarm": 0.35,
        "lullHours": 3,
        "incidentGapHours": 4,
        "beatClearHours": 3,
        "incidentPushFloor": -0.25,
        "seenWeight": 0.4,
        "playerWeight": 1.5,
        "nobodyWeight": 0.25,
        "answers": { "Raid": "Forge", "Shortage": "Kitchen", "Plague": "Shrine", "Brawl": "Tavern" }
      },
      // A beat may follow a quest instead ("followsQuest": a quest's name, "afterHours": [earliest,
      // latest] after its party sets out, "replaces": another beat's "id", "omen": what the town
      // hears then): it comes only if a party goes, and never into the festival.
      "beats": [
        { "day": 1, "fromHour": 20, "toHour": 23, "strength": 0.5, "kinds": { "Raid": 1 } },
        { "day": 2, "fromHour": 10, "toHour": 17, "strength": 1, "kinds": { "Raid": 3, "Fire": 2, "Shortage": 2, "Plague": 2, "Brawl": 2 } },
        // The dragon on the last morning: gone (DragonCrisis.Hours) and its fires out before the
        // festival goes up at festivalSetupHour, never into it (DirectorTests checks).
        { "day": 3, "fromHour": 6, "toHour": 8, "strength": 1.2, "kinds": { "Dragon": 1 } }
      ]
    }
  ]
}
