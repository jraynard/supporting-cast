// The season's festival (Defs/FestivalDefs.cs, Round/FestivalSystem.cs): the last evening, from
// season.json's festivalHour for its festivalHours. It opens with the bell (openingHours), then the
// revels: the feast tables, dancing round the bonfire, the show table and the games. The last
// ceremonyHours are the ceremony: the bell again, each party's toast (where what they think of the
// town is counted), the honours, and the verdict, then the reveal.
// What's put up in the square is the map's (maps/*.json "festival", from tools/village_map.py).
{
  "festivals": [
    {
      "name": "Festival",
      "openingHours": 0.5,
      "ceremonyHours": 1.25,
      "bellMinutes": 10,
      "toastMinutes": 6,
      "honourMinutes": 4,
      "verdictMinutes": 8,
      "maxHonours": 5,
      // What people do with the revels, by weight. Visitors look over the show table and watch the
      // games more; the town eats and dances more.
      "activities": { "Mill": 1, "Feast": 3, "Bonfire": 1.5, "Dance": 3, "Games": 1.5, "Show": 0.5 },
      "visitorActivities": { "Mill": 0.5, "Feast": 2, "Bonfire": 1, "Dance": 1.5, "Games": 2.5, "Show": 2.5 },
      // Each piece on the show table, by quality (crude, plain, fine, masterwork): a visitor's
      // satisfaction for looking it over, once each.
      "admireSatisfaction": [ -0.5, 0.25, 1, 2 ],
      "admireReach": 3,
      // A turn at a game, seen: satisfaction for each visitor near it, to a cap for the evening.
      "watchSatisfaction": 0.3,
      "watchCap": 1.5,
      "watchReach": 6,
      "tryChance": 0.25,
      "prizeSilver": 8,
      "gameRenown": 2,
      "games": [
        { "name": "Striker", "label": "the striker", "def": "HighStriker", "verb": "Swing at the striker", "skill": "Melee",
          "honour": "the strongest arm in the valley" },
        { "name": "Butts", "label": "the butts", "def": "ArcheryButt", "verb": "Shoot at the butts", "skill": "Shooting",
          "honour": "the truest eye at the butts" }
      ]
    }
  ],

