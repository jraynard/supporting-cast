      "depthMin": 2, "depthMax": 6, "scale": 7, "threshold": 0.7, "salt": 9001 },
    { "name": "ClayBank", "block": "Clay", "hosts": [ "Sand" ], "depthMin": 1, "depthMax": 1,
      "scale": 6, "threshold": 0.5, "salt": 9103, "moistureMin": 0.45, "flat": true },
