{
  // Mining and the tool ladder (docs/plans/mining-progression.md). A tool's tier is the best rock
  // its pick breaks (blocks' "digTier") and the finest recipe it serves (recipes' "toolTier").
  // Defs write tiers by name ("tier": "Bronze") or number.
  "tiers": [
    { "name": "Hands", "label": "bare-handed", "tier": 0 },
    { "name": "Stone", "label": "stone", "tier": 1 },
    { "name": "Copper", "label": "copper", "tier": 2 },
    { "name": "Bronze", "label": "bronze", "tier": 3 },
    { "name": "Iron", "label": "iron", "tier": 4 },
    { "name": "Steel", "label": "steel", "tier": 5 },
    { "name": "Dragonforged", "label": "dragonforged", "tier": 6 }
  ],

  // Kinds of stone: dug stone comes in the rock's material, and cut stone and stone walls and
  // floors keep it ("granite wall"). Factors scale what's made of it (Defs.MaterialDef).
  "materials": [
    { "name": "Sandstone", "label": "sandstone", "of": "Stone", "color": [1.0, 0.86, 0.62],
      "hpFactor": 0.8, "workFactor": 0.8, "massFactor": 0.9, "character": "soft and quick to work" },
    { "name": "Limestone", "label": "limestone", "of": "Stone", "color": [1.0, 0.98, 0.9], "character": "the common stone" },
    { "name": "Granite", "label": "granite", "of": "Stone", "color": [1.0, 0.86, 0.84],
      "hpFactor": 1.5, "insulation": 0.01, "workFactor": 1.4, "massFactor": 1.2, "beauty": 1, "character": "the strongest walls, slow to dress" },
    { "name": "Slate", "label": "slate", "of": "Stone", "color": [0.72, 0.78, 0.9],
      "hpFactor": 1.1, "insulation": 0.02, "workFactor": 1.1, "massFactor": 0.9, "beauty": 1, "character": "splits flat: the warmest floors" },
    { "name": "Basalt", "label": "basalt", "of": "Stone", "color": [0.55, 0.53, 0.58],
      "hpFactor": 1.8, "insulation": 0.01, "workFactor": 1.6, "massFactor": 1.3, "character": "black and heavy, near unbreakable" }
  ],

  // Rock. "digTier": the pick it takes (tiers above). Rough stone (core.json) stays tier 0.
  "blocks": [
    { "name": "Sandstone", "label": "sandstone", "sprite": "terrain/sandstone", "spriteSide": "terrain/sandstone_side", "moveCost": 1.0,
      "digWork": 450, "digYield": [ { "def": "Stone", "count": 8, "material": "Sandstone" } ], "digTool": "Pick" },
    { "name": "Limestone", "label": "limestone", "sprite": "terrain/limestone", "spriteSide": "terrain/limestone_side", "moveCost": 1.0,
      "digWork": 600, "digYield": [ { "def": "Stone", "count": 8, "material": "Limestone" } ], "digTool": "Pick", "digTier": "Stone" },
    { "name": "Granite", "label": "granite", "sprite": "terrain/granite", "spriteSide": "terrain/granite_side", "moveCost": 1.0,
      "digWork": 1000, "digYield": [ { "def": "Stone", "count": 8, "material": "Granite" } ], "digTool": "Pick", "digTier": "Copper" },
    { "name": "Slate", "label": "slate", "sprite": "terrain/slate", "spriteSide": "terrain/slate_side", "moveCost": 1.0,
      "digWork": 800, "digYield": [ { "def": "Stone", "count": 8, "material": "Slate" } ], "digTool": "Pick", "digTier": "Copper" },
    { "name": "Basalt", "label": "basalt", "sprite": "terrain/basalt", "spriteSide": "terrain/basalt_side", "moveCost": 1.0,
      "digWork": 1300, "digYield": [ { "def": "Stone", "count": 8, "material": "Basalt" } ], "digTool": "Pick", "digTier": "Iron" },

    // Ore ("ore": true) is hidden, passing for the rock around it, until a face of it is opened.
    { "name": "CopperOre", "label": "copper ore", "sprite": "terrain/copper_ore", "spriteSide": "terrain/copper_ore_side", "moveCost": 1.0,
      "digWork": 700, "digYield": [ { "def": "CopperOre", "count": 4 }, { "def": "Stone", "count": 1, "material": "Limestone" } ],
      "digTool": "Pick", "digTier": "Stone", "ore": true, "stain": [0.82, 1.0, 0.88], "hostRock": "Limestone" },
    { "name": "TinOre", "label": "tin ore", "sprite": "terrain/tin_ore", "spriteSide": "terrain/tin_ore_side", "moveCost": 1.0,
      "digWork": 800, "digYield": [ { "def": "TinOre", "count": 3 }, { "def": "Stone", "count": 1, "material": "Granite" } ],
      "digTool": "Pick", "digTier": "Stone", "ore": true, "stain": [0.86, 0.86, 0.9], "hostRock": "Granite" },
    { "name": "CoalSeam", "label": "coal seam", "sprite": "terrain/coal", "spriteSide": "terrain/coal_side", "moveCost": 1.0,
      "digWork": 500, "digYield": [ { "def": "Coal", "count": 5 } ],
      "digTool": "Pick", "digTier": "Stone", "ore": true, "stain": [0.8, 0.8, 0.8], "hostRock": "Sandstone" },
    { "name": "SilverOre", "label": "silver ore", "sprite": "terrain/silver_ore", "spriteSide": "terrain/silver_ore_side", "moveCost": 1.0,
      "digWork": 900, "digYield": [ { "def": "SilverOre", "count": 2 }, { "def": "Stone", "count": 2, "material": "Granite" } ],
      "digTool": "Pick", "digTier": "Copper", "ore": true, "stain": [0.92, 0.96, 1.0], "hostRock": "Granite" },
    { "name": "GoldOre", "label": "gold ore", "sprite": "terrain/gold_ore", "spriteSide": "terrain/gold_ore_side", "moveCost": 1.0,
      "digWork": 1000, "digYield": [ { "def": "GoldOre", "count": 2 }, { "def": "Stone", "count": 2, "material": "Granite" } ],
      "digTool": "Pick", "digTier": "Bronze", "ore": true, "stain": [1.0, 0.94, 0.76], "hostRock": "Granite" },
    { "name": "EmberCrystal", "label": "ember crystal", "sprite": "terrain/ember_crystal", "spriteSide": "terrain/ember_crystal_side", "moveCost": 1.0,
      "digWork": 1500, "digYield": [ { "def": "EmberCrystal", "count": 2 }, { "def": "Stone", "count": 2, "material": "Basalt" } ],
      "digTool": "Pick", "digTier": "Steel", "ore": true, "stain": [1.0, 0.8, 0.68], "hostRock": "Basalt" }
  ],

