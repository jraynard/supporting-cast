// The empath's mendings (Healing/CastSession). An empath draws a patient's wound into their own
// body, then casts on themselves the mending that fits it. They know a wound they've taken only by
// how it feels ("feels", one line per kind it heals), so telling which mending a wound wants is a
// skill the player learns. A wrong mending costs its mana and heals nothing. "runes" is the cast,
// played on cue: L (A), R (D), F. "heal" is damage mended by a perfect cast.
{
  "mendings": [
    { "name": "Knit", "label": "Knitting", "description": "Draws parted flesh back together.",
      "heals": [ "Cut", "Pierce", "Bite" ], "manaCost": 20, "heal": 16, "runes": "LRLF",
      "feels": { "Cut": "a clean, bright line of pain", "Pierce": "a deep, narrow ache, like a nail left in",
                 "Bite": "a ragged, tearing soreness" } },
    { "name": "Ease", "label": "Easing", "description": "Soothes crushed and swollen flesh until it settles.",
      "heals": [ "Blunt" ], "manaCost": 15, "heal": 18, "runes": "RRF",
      "feels": { "Blunt": "a deep, swelling throb" } },
    { "name": "Cool", "label": "Cooling", "description": "Draws the fire out of burned skin.",
      "heals": [ "Burn" ], "manaCost": 22, "heal": 14, "runes": "FLLF",
      "feels": { "Burn": "tight, hot skin that won't stop stinging" } },
    { "name": "Kindle", "label": "Kindling", "description": "Brings warmth and blood back into frozen flesh.",
      "heals": [ "Frost" ], "manaCost": 22, "heal": 14, "runes": "FRRF",
      "feels": { "Frost": "numbness, then needles" } },
    { "name": "Cleanse", "label": "Cleansing", "description": "Burns out venom and festering.",
      "heals": [ "Venom" ], "cleanses": true, "manaCost": 30, "heal": 10, "runes": "LFRFL",
      "feels": { "Venom": "a sick, spreading heat under the skin" } }
  ]
}
