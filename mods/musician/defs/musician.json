// The musician (docs/MUSICIAN-PLAN.md): a professional musician, the town's own (not an adventurer's
// class), a trade only a player takes, never an AI villager's.
{
  "trades": [
    { "name": "Musician", "label": "musician", "pace": "Easygoing", "playerOnly": true, "formerly": [ "Bard" ],
      // Comes in by the road at the deal, a pack of instruments on their back (Players.ArriveByRoad).
      "arrivesByRoad": "{name} comes wandering in from the road, a lute on their back and a pipe in their belt.",
      "description": "Music for the town: the pipe, the lute, the fiddle and the drum, for whoever will listen. Comes only if someone plays it.",
      // A dagger at the belt for the road and a raid (R draws it): instruments are no use against a blade.
      "kit": [ { "def": "Dagger" }, { "def": "Pipe" }, { "def": "Lute" }, { "def": "Fiddle" }, { "def": "HandDrum" }, { "def": "Hat" }, { "def": "Strings", "count": 4 } ],
      "tutorialIntro": "You're the town's musician: a pipe, a lute, a fiddle and a hand drum in your pack, and no shop. Take one in hand and press F to play. Play where people gather (the inn of an evening, the square, a party setting out) and they'll come to listen, dance, and toss silver in your hat.",
      // ~@id~ names any action by its id (a mod's own as "musician:note1"), so the words follow the player's bindings.
      "lessons": [
        { "id": "scale", "title": "Play a scale", "core": true,
          "blurb": "Take out the pipe and play its eight notes, from the low D up to the high one.",
          "steps": [
            { "id": "start", "text": "Take the tin pipe in hand (~1-4~, or from your pack with ~Tab~), then press ~F~ where you stand to play it." },
            { "id": "scale", "text": "Each note key plays a note of the scale: ~@musician:note1~ is the low D, up to ~@musician:note8~, the D above. Play all eight in order, low to high.",
              "more": "Hold a key and the note sounds till you let go. Hold ~@musician:octave~ with a key for the octave above, ~@musician:sharp~ for a semitone up, and ~AD~ bends the note sounding." } ],
          "notes": [ "This is free play: play anything you like, nobody's judging the notes, only whether it's steady.",
                     "Take another instrument in hand (~Tab~) and ~F~ plays that one instead: the lute, the fiddle or the drum. With empty hands, or on a bed or at a bench, ~F~ does what it always does." ] },
        { "id": "tune", "title": "Strike up a tune", "core": true,
          "blurb": "Play the first notes of a tune from your book, and your hands carry the rest while you keep time.",
          "steps": [
            { "id": "start", "text": "Take the pipe in hand (~1-4~ or ~Tab~) and press ~F~ to play it." },
            { "id": "book", "text": "Press ~Space~ to open your book of tunes." },
            { "id": "opening", "text": "~WS~ picks a tune; its first notes are drawn for you. Play them on the note keys, from any note, and your hands take over.",
              "more": "Start after a moment's quiet, and keep the notes' shape: it's matched by the steps between them, so you can start on any key." },
            { "id": "carry", "text": "Now keep the tune going: press ~F~ on each beat as the ring closes, long notes too. Hold ~@musician:swell~ through a long note to swell it. Play it to the end.",
              "more": "Miss beats and your mind wanders: notes go missing, and in the end the tune slips away. A few beats kept bring it back. ~AD~ nudges the pace if it runs away from you." } ],
          "notes": [ "Each instrument's own tune comes first in its book: the pipe's jig, The Miller's Wheel; the lute's air, Lantern Home; the fiddle's reel, Hay in the Loft.",
                     "A lively, steady tune gets people dancing; a slow one, listening; a ragged or out-of-tune one drives them off." ] },
        { "id": "strings", "title": "Tune the lute", "core": true,
          "blurb": "A lute left a while goes out of tune: bring each string back to its note by ear.",
          "steps": [
            { "id": "lute", "text": "Take the lute in hand: open your pack (~Tab~) and take it out." },
            { "id": "start", "text": "Press ~F~ to play it (you'll hear it's out), then ~@rune_9~ to tune it." },
            { "id": "tune", "text": "Hold ~F~ to sound the string against its true note: the wave wobbles while it's out. Turn the peg with ~AD~ till the wobble slows and stops, then ~Space~ for the next string. ~Esc~ when they're all true.",
              "more": "The slower the wobble, the closer you are. Wind a string far past its note and it may snap: then ~F~ fits a spare." } ],
          "notes": [ "Strings drift flat as they're played: an evening's playing and they're sour. Tune between tunes.",
                     "The fiddle tunes the same way." ] },
        { "id": "busk", "title": "Busking", "customers": "Trade",
          "blurb": "Play where people are, and your hat earns its keep.",
          "steps": [
            { "id": "start", "text": "Go where people gather (the inn's common room is best), an instrument in hand, and press ~F~ to play. Your hat goes down at your feet." },
            { "id": "tips", "text": "Play well and keep playing: those who listen a good while toss silver in your hat, more if they dance. When someone calls for a tune, play it for them.",
              "more": "~@musician:thank~ bows to whoever just tipped you. When you stop, your hat and what's in it come back up with you." } ],
          "notes": [ "Each listener tips once a day; adventurers tip the most.",
                     "Music at the inn makes adventurers thirstier, and a party setting out to a lively tune goes off in better heart." ] }
      ] }
  ],
  "things": [
    // A tin whistle in D. Its music is the musician mod's own kind of def, below.
    { "name": "Pipe", "label": "tin pipe", "category": "Item", "mass": 0.2, "sprite": "items/pipe", "flammability": 0.1, "maxHp": 40 },
    { "name": "Lute", "label": "lute", "category": "Item", "mass": 1.6, "sprite": "items/lute", "flammability": 0.8, "maxHp": 30 },
    { "name": "Fiddle", "label": "fiddle", "category": "Item", "mass": 0.6, "sprite": "items/fiddle", "flammability": 0.8, "maxHp": 30 },
    { "name": "HandDrum", "label": "hand drum", "category": "Item", "mass": 1.2, "sprite": "items/hand_drum", "flammability": 0.6, "maxHp": 40 },
    // A spare string (gut), for the lute or the fiddle: fitted where one's snapped (TuneSession), slack till it's tuned.
    { "name": "Strings", "label": "spare string", "category": "Item", "mass": 0.01, "sprite": "items/strings", "stackLimit": 20,
      "flammability": 0.8, "maxHp": 5, "description": "A coil of gut string, for a lute or a fiddle." },
    // Set down at the musician's feet as they play (Takings): listeners toss silver down by it, and it's all taken up
    // when they stop. Not a container: a pack can't carry one, and it's the silver lying there that's real.
    { "name": "Hat", "label": "musician's hat", "category": "Item", "mass": 0.2, "sprite": "items/hat", "stackLimit": 1,
      "flammability": 0.8, "maxHp": 20,
      "description": "A felt hat with a wide brim, turned up to take coins." }
  ],
  // What the audience remembers of an evening's music (Audience.cs: AudienceJob), as memories (mood.json's format).
  "thoughts": [
    { "name": "HeardMusic", "label": "heard some music", "description": "Stood a while and listened to a musician play.", "mood": 3, "durationHours": 6, "races": [ "Human" ] },
    { "name": "Danced", "label": "danced", "description": "Danced to a musician's tune.", "mood": 5, "durationHours": 8, "races": [ "Human" ] },
    { "name": "HeardTheirTune", "label": "heard the tune they asked for", "description": "Called for a tune, and the musician played it.", "mood": 6, "durationHours": 8, "races": [ "Human" ] },
    { "name": "SentOffWithASong", "label": "sent off with a song", "description": "Set out on the road to a musician's tune.", "mood": 5, "durationHours": 12, "races": [ "Human" ] },
    { "name": "SourMusic", "label": "suffered sour music", "description": "Stood through a tune gone to pieces, and gave up on it.", "mood": -2, "durationHours": 3, "races": [ "Human" ] }
  ],
  // A listener calling for a tune (Takings.Ask): {thing} is the tune.
  "barks": [
    { "name": "musician.request", "lines": [
      { "text": "Give us {thing}, musician!" },
      { "text": "Do you know {thing}? Play it!" },
      { "text": "{thing}! Play {thing}!", "when": [ "merry" ] },
      { "text": "Play us {thing}, would you? For the road.", "when": [ "adventurer" ] }
    ] }
  ],
  // The musician mod's own kind (DefDatabase.ModDefs): how an instrument sounds and what it plays.
  "instruments": [
    // Whatever's in hand is played (F), or the first in the pack. "air": what a carried tune spends and is given back at
    // its marks (Breath, Bow; none for plucked and struck: no longer spent, kept for what the instrument is); "sustains":
    // a note lasts while held, and a carried tune's long notes are swelled (the swell key held through them);
    // "bend": semitones A/D bend a note (a drum: W pressing its head).
    { "name": "Pipe", "label": "tin pipe", "voice": "Breath", "air": "Breath", "sustains": true, "bend": 1,
      // One root sample per octave (sounds/sounds.json), each pitched up to the scale's notes.
      "octaves": [ "musician.pipe.d5", "musician.pipe.d6" ],
      // A held note: a loop per octave (sounds while the key's held), and the breath's burst as it speaks.
      "held": [ "musician.pipe.d5.loop", "musician.pipe.d6.loop" ], "attack": "musician.pipe.chiff",
      // The major scale from the root, in semitones: the eight note keys.
      "scale": [ 0, 2, 4, 5, 7, 9, 11, 12 ],
      // Its root, D5, for naming the notes (the keys play D E F# G A B C# D).
      "root": "D", "rootOctave": 5 },
    // Plucked: each note rings and dies away of itself, as many at once as are played. Its tunes are kept by the beat alone.
    // Q with a note key holds the chord on it (the scale's triad), F strums it, down and up.
    // "strings": each its open note in semitones from the root; a note is played on the highest string at or under it
    // (Tuning): out of tune, its notes are; snapped, they don't sound.
    { "name": "Lute", "label": "lute", "voice": "Plucked", "chords": true,
      "strings": [ { "name": "D", "semis": 0 }, { "name": "G", "semis": 5 }, { "name": "B", "semis": 9 }, { "name": "E", "semis": 14 }, { "name": "A", "semis": 19 } ],
      "octaves": [ "musician.lute.d4", "musician.lute.d5" ],
      "scale": [ 0, 2, 4, 5, 7, 9, 11, 12 ], "root": "D", "rootOctave": 4 },
    // Bowed: a note sounds while it's held, slides with A/D, and a carried tune's long notes swell under the bow.
    { "name": "Fiddle", "label": "fiddle", "voice": "Bowed", "air": "Bow", "sustains": true, "bend": 2,
      "strings": [ { "name": "G", "semis": -7 }, { "name": "D", "semis": 0 }, { "name": "A", "semis": 7 }, { "name": "E", "semis": 14 } ],
      "octaves": [ "musician.fiddle.d4", "musician.fiddle.d5" ],
      // Held notes: a loop for every key, each made at its own pitch (the body's resonances stay put), the bow swelling in.
      "held": [ "musician.fiddle.k00", "musician.fiddle.k01", "musician.fiddle.k02", "musician.fiddle.k03", "musician.fiddle.k04", "musician.fiddle.k05", "musician.fiddle.k06", "musician.fiddle.k07", "musician.fiddle.k08", "musician.fiddle.k09", "musician.fiddle.k10", "musician.fiddle.k11", "musician.fiddle.k12", "musician.fiddle.k13", "musician.fiddle.k14", "musician.fiddle.k15" ],
      "attack": "musician.fiddle.bow", "fade": 0.09,
      "scale": [ 0, 2, 4, 5, 7, 9, 11, 12 ], "root": "D", "rootOctave": 4 },
    // Struck: strokes, not notes: the low open stroke, the high one at the edge, and the rim's click. W presses the head.
    { "name": "HandDrum", "label": "hand drum", "voice": "Struck", "bend": 3, "book": false,
      "strokes": [ "doum", "tek", "ka" ],
      "octaves": [ "musician.drum.doum", "musician.drum.tek", "musician.drum.ka" ] }
  ],
  // The tune book (the musician mod's own kind, DefDatabase.ModDefs): our own tunes, or public-domain ones
  // written out in our own notation, never a game's or a film's. A note is [step, beats, accidental]: steps of
  // the scale from the instrument's root, 0..14 across its two octaves (7 is the octave key, 8 the second
  // octave's second; -1 a rest; [-2] a breath mark after the note before), how long, and -1/+1 for a semitone off
  // (optional). Notes of 2 beats or more are long ones, to be shaped. A tune of one part gives
  // "notes"; a longer one gives "parts" and the "form" they're played in. In the book, play a tune's call (the
  // first "opening" notes, 5 unless it says, of the part named "call", the first unless it says), from any step after a
  // pause, and the musician's hands play the tune: from the top, or from the call on if it's the first part
  // while you keep the beat and swell the long notes (PlaySession): the openings must differ in shape. A breath mark
  // is phrasing now, nothing to mind: the note before it lifts early.
  "songs": [
    // Our own tunes, each written for an instrument ("for": it comes first in that one's book; any tune plays on any
    // instrument but the drum). About 40 to 50 seconds each: long enough to settle into, short enough for a round.

    // "The Miller's Wheel", for the pipe: a jig. Its two phrases, a turn higher as the wheel comes round, home again,
    // and the first phrases once more.
    { "name": "MillersWheel", "label": "The Miller's Wheel", "for": "Pipe", "kind": "Jig", "mood": "Lively", "tempo": 116,
      "notes": [ [0,1], [2,1], [4,1], [4,1], [5,1], [4,2], [-2], [2,1], [3,1], [1,1], [2,2], [0,2], [-2],
                 [4,1], [5,1], [7,1], [5,1], [4,1], [2,2], [3,1], [1,1], [0,3], [-2],
                 [7,1], [8,1], [9,1], [9,1], [8,1], [7,2], [5,1], [6,1], [7,1], [8,2], [-2],
                 [9,1], [8,1], [7,1], [5,1], [4,1], [5,2], [3,1], [2,1], [1,1], [0,3], [-2],
                 [0,1], [2,1], [4,1], [4,1], [5,1], [4,2], [-2], [2,1], [3,1], [1,1], [2,2], [0,2], [-2],
                 [4,1], [5,1], [7,1], [5,1], [4,1], [2,2], [3,1], [1,1], [0,3], [-2] ] },
    // "Lantern Home", for the lute: a slow air. Its two lines, a rise and a fall home, then its first line and the close.
    { "name": "LanternHome", "label": "Lantern Home", "for": "Lute", "kind": "Air", "mood": "Tender", "tempo": 80,
      "notes": [ [4,2], [3,1], [2,1], [1,2], [2,1], [4,1], [5,3], [-2],
                 [4,1], [2,2], [1,1], [0,1], [1,2], [2,4], [-2],
                 [5,2], [7,1], [8,1], [7,2], [5,1], [4,1], [5,3], [-2],
                 [7,1], [5,2], [4,1], [2,1], [1,2], [0,4], [-2],
                 [4,2], [3,1], [2,1], [1,2], [2,1], [4,1], [5,3], [-2],
                 [7,1], [5,2], [4,1], [2,1], [1,2], [0,4], [-2] ] },
    // "Hay in the Loft", for the fiddle: a reel. An A part running up and down, a B part higher, A again; long notes at
    // the phrases' ends for the bow to swell.
    { "name": "HayInTheLoft", "label": "Hay in the Loft", "for": "Fiddle", "kind": "Reel", "mood": "Lively", "tempo": 144,
      "parts": {
        "A": [ [7,1], [7,1], [4,1], [7,1], [9,1], [7,1], [6,1], [4,1], [5,1], [6,1], [7,2], [-2],
               [4,1], [2,1], [4,1], [5,1], [4,1], [2,1], [1,1], [0,2], [-2],
               [7,1], [7,1], [4,1], [7,1], [9,1], [10,1], [9,1], [7,1], [8,1], [6,1], [7,2], [-2],
               [5,1], [4,1], [2,1], [4,1], [1,1], [2,1], [0,3], [-2] ],
        "B": [ [9,1], [10,1], [11,1], [9,1], [10,1], [8,1], [9,2], [-2],
               [7,1], [8,1], [9,1], [7,1], [8,1], [6,1], [7,2], [-2],
               [9,1], [10,1], [11,1], [12,1], [11,1], [9,1], [10,2], [-2],
               [9,1], [7,1], [8,1], [6,1], [7,1], [5,1], [4,1], [2,1], [0,3], [-2] ] },
      "form": [ "A", "B", "A" ] }
  ]
}
