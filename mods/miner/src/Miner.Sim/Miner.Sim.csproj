<Project Sdk="Microsoft.NET.Sdk">

  <!-- The miner's sim half (docs/MODDING.md): it references only the game's sim, and builds into the
       mod's folder, where the game loads it from. Built against the sim's banned-API list, as every mod is. -->
  <PropertyGroup>
    <RootNamespace>HeroesNotIncluded.Miner</RootNamespace>
    <OutDir>$(MSBuildThisFileDirectory)../../</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- Only the mod's own DLL in its folder: the game's assemblies are the game's. -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\HeroesNotIncluded.Sim\HeroesNotIncluded.Sim.csproj" Private="false" />
    <ProjectReference Include="..\..\..\..\external\narsil\src\Narsil.Sim\Narsil.Sim.csproj" Private="false" />
    <PackageReference Include="Ahwoo.BRUTAL.Numerics" Version="2026.10.1" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" PrivateAssets="all" />
    <AdditionalFiles Include="..\..\..\..\src\HeroesNotIncluded.Sim\BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Brutal.Numerics" />
    <Using Include="HeroesNotIncluded.Sim.Ecs" />
    <Using Include="HeroesNotIncluded.Sim.Core" />
    <Using Include="Narsil.Sim.Core" />
    <Using Include="Narsil.Sim.Grid" />
  </ItemGroup>

</Project>
