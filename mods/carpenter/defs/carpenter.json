  "trades": [
    // The carpenter works the woodshop: planks at the sawhorse, arrows at the bench for the parties'
    // archers, the bridge braced when a raid brings it down, and the festival put up (Carpentry/).
    { "name": "Carpenter", "label": "carpenter", "level": "Intermediate", "description": "Wood and arrows: saws planks, fletches quivers for the parties' archers, mends their bows and cudgels, braces the bridge when it's down and puts up the festival.",
      "standingOrders": [ { "supply": "Feathers", "keep": 8 } ],
      "workplace": "Woodshop", "workPriorities": { "Craft": 1, "Construct": 2 }, "skills": { "Crafting": 5, "Construction": 6, "Shooting": 4 }, "mendsTown": true, "builds": true,
      "fells": true,
      "knows": [ "Sawhorse", "CarpenterBench", "ChoppingBlock" ],
      "stations": [ "Sawhorse", "CarpenterBench", "ChoppingBlock" ],
      "tutorialIntro": "You're the carpenter. Logs come in, planks and arrows go out. Archers in the parties need arrows for the road, and a well-fletched quiver brings them home. A worn bow or a split cudgel is yours to mend, not the smith's. When the bridge comes down, or the festival needs putting up, the town looks to you.",
      "lessons": [
        { "id": "saw", "title": "Saw some planks", "core": true,
          "blurb": "Hew a log square with the axe, then saw the beam into planks along its chalk lines.",
          "steps": [
            { "id": "logs", "text": "Take a log from the woodshop's chest (~F~). It's heavy: you'll carry it in both arms." },
            { "id": "start", "text": "Carry it to the sawhorse, hold ~F~ there and choose planks." },
            { "id": "hew", "text": "First hew the log square. Hold ~F~ to raise the axe and let go to strike: the higher it's raised, the deeper the blow. Bring the right side flat down to the chalk line, then press ~Space~ (or right-click) to turn the log to the next.",
              "more": "The dashed line shows where the blow will cut to. Past the chalk line is waste, wood left on is rough: finish a side with a light blow." },
            { "id": "saw", "text": "Then saw the beam, as the top sawyer: ~S~ pulls the saw down (that's what cuts), ~W~ draws it back up. When the blade wanders off the line, the arrow shows the way back: ~A~ or ~D~.",
              "more": "Long, steady strokes: a rushed one wanders. The squarer the log and the straighter the cuts, the more planks you get." } ],
          "notes": [ "A log makes up to four planks: a crooked cut wastes some.",
                     "When the chest's out of logs, fell a tree for more. The barn's timber saws into planks too, at a pinch, and a great log makes ten long ones with a pitman." ] },
        { "id": "quiver", "title": "Make a quiver of arrows", "core": true,
          "blurb": "Make one fine arrow at the bench, cut the rest to match, and put the quiver out for the parties' archers.",
          "steps": [
            { "id": "start", "text": "Hold ~F~ at the carpenter's bench and choose a quiver of arrows. It takes a plank and a bundle of feathers." },
            { "id": "sight", "text": "First sight the shaft: hold ~F~ to bend it against its warp, and press ~Space~ when the needle reads straight. Bend too far and it warps the other way.",
              "more": "Your eye isn't perfect: the needle is what you see, and a shaft can look truer than it is. Steady hands see better." },
            { "id": "shave", "text": "Shave it smooth: move the knife with the mouse (or ~WASD~) and hold the button (or ~F~) to shave. Take the lumps down to the shaft's line, then press ~Space~.",
              "more": "Below the line the knife bites into the shaft, and a gouge costs more than a little wood left on." },
            { "id": "head", "text": "Fit the head: hold ~F~ to push it onto the shaft. It tips as it goes on: ~A~/~D~ (or the mouse) keep it on the line." },
            { "id": "fletch", "text": "Then fletch it: point round the shaft with the mouse (or ~A~/~D~) and click (or ~F~) to set a feather. Three, evenly round it." },
            { "id": "show", "text": "Put the quiver on the wares shelf at the woodshop's front (~F~ at it with the quiver in hand, or from your pack). It goes up for sale at once: open the shelf to change its price. Archers take one down and pay you before they set out: you needn't be there.", "ui": "inventory" } ],
          "notes": [ "Only archers buy quivers: a party with a bow or two in it will come looking. An archer with none who finds your shelf bare asks you for one aloud: hand it to them and they pay.",
                     "A true quiver brings an archer home in better shape. A warped one flies wide, and nobody can tell until it does.",
                     "When raiders bring the bridge down, it's yours to mend: take 2 wood to the gap and press ~F~." ] },
        { "id": "bow", "title": "Tiller a bow", "supply": [ { "def": "Planks", "count": 4 } ],
          "blurb": "Scrape a bow stave until both limbs bend in an even arc. A good bow sells to a party's archer.",
          "steps": [
            { "id": "start", "text": "Hold ~F~ at the carpenter's bench and choose a hunting bow. It takes four planks." },
            { "id": "tiller", "text": "The stave's on the tillering stick. Each bar under it is wood still to come off a section. ~A~/~D~ (or the mouse) picks one; hold ~F~ to scrape it down to its mark. When every bar's at its mark, press ~Space~.",
              "more": "Short strokes: the scraper bites harder the longer you hold it, and wood scraped off can't go back. A bar below its mark is a hinge, worse than one left stiff." },
            { "id": "string", "text": "String it: hold ~F~ to bend the bow against the floor, and press ~Space~ to slip the loop into the nock once the gauge is in the green.",
              "more": "Too soon and the loop slips past: bend it again. Bend it into the red and the limbs strain." } ],
          "notes": [ "Put a bow down in the woodshop (~G~) and price it: an archer with a worse one will buy it.",
                     "When the town calls for arms before a raid, a bow hung on the muster rack is paid for like the smith's spears.",
                     "An archer's worn bow comes to you to mend: take it, choose Mend at the bench, and re-tiller it where it's set stiff." ] },
        { "id": "woods", "title": "Fell a tree",
          "blurb": "Drop a tree where you mean it to fall, saw the trunk into logs where it lies, and carry one home.",
          "steps": [
            { "id": "tree", "text": "Go to a tree, an axe on you, and press ~F~ at it to fell it. Pick one with room round it." },
            { "id": "aim", "text": "Aim the fall: ~A~/~D~ turn the arrow. Keep it off roofs and people. The tree leans a little somewhere; mind the lean arrow.",
              "more": "The line on the ground shows where it will come down, as long as the tree is tall." },
            { "id": "notch", "text": "Cut the notch on the side it's to fall: hold ~F~ to raise the axe and let go to strike, down to the chalk mark. Then press ~Space~ to go round for the back cut.",
              "more": "Too shallow and the notch won't steer it: it goes the way it leans. Too deep weakens the hinge." },
            { "id": "back", "text": "Back cut from the other side. Each blow thins the hinge left between the cuts; when it's thin, the tree goes. Shout, and stand clear.",
              "more": "Cut through the hinge and nothing steers it: it falls with its lean, whatever you aimed. It hurts anyone it lands on." },
            { "id": "buck", "text": "Saw the trunk into logs where it lies: ~F~ at it, then ~S~ pulls the saw (that cuts) and ~W~ pushes it back. Past halfway, press ~Space~ to drive a wedge in before the cut closes on the saw.",
              "more": "An oak's butt is thick: someone on the other end of the saw (Help! from the quick-say wheel) makes it go far faster. With only its butt left, ~Space~ keeps it whole as a great log for the pit saw." },
            { "id": "carry", "text": "Carry a log home to the sawhorse. It's heavy: you'll walk slowly with it, and a great log slower still." } ],
          "notes": [ "A log saws into four planks, a great log into ten long ones with a pitman.",
                     "Logs split into firewood at the chopping block, for when the town's fires run short." ] },
        { "id": "firewood", "title": "Split firewood", "supply": [ { "def": "Log", "count": 1 } ],
          "blurb": "Split a log into firewood at the chopping block. The town's hearths, ovens and kilns burn it.",
          "steps": [
            { "id": "start", "text": "Carry a log to the chopping block, hold ~F~ there and choose firewood." },
            { "id": "split", "text": "Put the axe's edge over the crack in the log's end (~A~/~D~), hold ~F~ to raise it past the mark and let go. A clean split shows the next crack.",
              "more": "A hard blow off the crack sticks the axe: press ~Space~ a few times to rock it free. A soft one just bounces." } ],
          "notes": [ "The carter brings most of the town's firewood. In a shortage none comes, and it's down to you.",
                     "A log gives four firewood, a great log eight." ] } ],
      "kit": [ { "def": "Axe" }, { "def": "Saw" }, { "def": "ClawHammer" }, { "def": "Planks", "count": 4 }, { "def": "Feathers", "count": 4 } ] }
  ],
