<Project Sdk="Microsoft.NET.Sdk">

  <!-- Game-side logic that needs no window or GPU: sprite sheets, animation choice, art audit. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HeroesNotIncluded\HeroesNotIncluded.csproj" />
    <ProjectReference Include="..\..\mods\carpenter\src\Carpenter.Sim\Carpenter.Sim.csproj" />
    <!-- The musician's and the miner's game halves, for their controls: lesson words name them (TutorialWordsTests). -->
    <ProjectReference Include="..\..\mods\musician\src\Musician.Sim\Musician.Sim.csproj" />
    <ProjectReference Include="..\..\mods\musician\src\Musician\Musician.csproj" />
    <ProjectReference Include="..\..\mods\miner\src\Miner.Sim\Miner.Sim.csproj" />
    <ProjectReference Include="..\..\mods\miner\src\Miner\Miner.csproj" />
    <!-- Built, not referenced: ModCodeTests loads it from a mod folder, as the game loads a mod. -->
    <ProjectReference Include="..\ExampleMod.Sim\ExampleMod.Sim.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Narsil.Sim.Core" />
    <Using Include="Narsil.Sim.Grid" />
    <Using Include="Narsil.Voxel" />
  </ItemGroup>

</Project>
