{
  "$schema": "http://json.schemastore.org/template",
  "author": "Heroes Not Included",
  "classifications": [ "Game", "Mod" ],
  "identity": "HeroesNotIncluded.Mod.Content",
  "name": "Heroes Not Included: a content mod",
  "shortName": "hni-content",
